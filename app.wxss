/* ---------- 配色主题 ----------
 * 变量挂在页面根节点的 .theme-xxx 上（各页 wxml 根节点写 class="... theme-{{themeKey}}"），
 * 页面里的主色用 var(--brand) / var(--hero-bg) 取，换一套主题全站跟着变。
 * 没挂 theme 类的地方会自动回落到 var(--brand, 原来的绿色)，不会坏。
 */
.theme-green {
  --brand: #17806b;
  --brand-ink: #0f5f50;
  --brand-soft: #e7f5ef;
  --brand-line: #cfe0da;
  --hero-bg: linear-gradient(160deg, #1a8f76 0%, #12695a 100%);
  --hero-bg-dark: linear-gradient(160deg, #145247 0%, #0c3730 100%);
  --hero-shadow: 0 16rpx 36rpx rgba(18, 105, 90, 0.2);
}

.theme-ink {
  --brand: #2f5d8a;
  --brand-ink: #1f4468;
  --brand-soft: #e8eff7;
  --brand-line: #cfdcea;
  --hero-bg: linear-gradient(160deg, #33638f 0%, #22486c 100%);
  --hero-bg-dark: linear-gradient(160deg, #223f5e 0%, #182b42 100%);
  --hero-shadow: 0 16rpx 36rpx rgba(34, 72, 108, 0.22);
}

.theme-amber {
  --brand: #b96a2b;
  --brand-ink: #8f4d18;
  --brand-soft: #fbeee2;
  --brand-line: #ecdccb;
  --hero-bg: linear-gradient(160deg, #c17a38 0%, #9a5822 100%);
  --hero-bg-dark: linear-gradient(160deg, #7a4520 0%, #4d2b14 100%);
  --hero-shadow: 0 16rpx 36rpx rgba(154, 88, 34, 0.22);
}

page {
  background: #f3f5f6;
  color: #1c1f23;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx;
  border: 1rpx solid #e6ece8;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8b9198;
  font-size: 24rpx;
}

.exp {
  color: #d9433f;
}

.inc {
  color: #1f7a4d;
}

.num {
  font-weight: 600;
}

.btn {
  background: var(--hero-bg, linear-gradient(135deg, #1a8f76 0%, #17806b 100%));
  color: #ffffff;
  border-radius: 20rpx;
  text-align: center;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: var(--hero-shadow, 0 10rpx 24rpx rgba(23, 128, 107, 0.22));
}

.btn.plain {
  background: #ffffff;
  color: var(--brand, #17806b);
  border: 2rpx solid var(--brand-line, #cfe0da);
  box-shadow: none;
}

.btn.disabled {
  background: #d7dbdd;
  color: #ffffff;
  box-shadow: none;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: #eef0f2;
  margin: 20rpx 0;
}

.empty {
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.ui-icon { position: relative; display: inline-block; width: 38rpx; height: 38rpx; flex: none; box-sizing: border-box; color: inherit; }
.ui-icon::before, .ui-icon::after { content: ''; position: absolute; box-sizing: border-box; }
.icon-plus::before { width: 30rpx; height: 3rpx; background: currentColor; left: 4rpx; top: 18rpx; border-radius: 2rpx; }
.icon-plus::after { height: 30rpx; width: 3rpx; background: currentColor; left: 18rpx; top: 4rpx; border-radius: 2rpx; }
.icon-user::before { width: 15rpx; height: 15rpx; border: 3rpx solid currentColor; border-radius: 50%; left: 12rpx; top: 0; }
.icon-user::after { width: 32rpx; height: 17rpx; border: 3rpx solid currentColor; border-radius: 20rpx 20rpx 5rpx 5rpx; left: 3rpx; bottom: 0; }
.icon-book, .icon-archive { border: 3rpx solid currentColor; border-radius: 5rpx; width: 30rpx; margin: 0 4rpx; }
.icon-book::before { height: 100%; border-left: 2rpx solid currentColor; left: 6rpx; }
.icon-book::after { width: 10rpx; height: 2rpx; background: currentColor; right: 4rpx; top: 10rpx; }
.icon-archive::before { width: 100%; border-top: 3rpx solid currentColor; top: 8rpx; }
.icon-archive::after { width: 10rpx; border-top: 3rpx solid currentColor; top: 19rpx; left: 7rpx; }
.icon-scan { border: 3rpx solid currentColor; border-radius: 7rpx; }
.icon-scan::before { width: 22rpx; height: 3rpx; top: 15rpx; left: 5rpx; background: currentColor; }
.icon-scan::after { width: 4rpx; height: 4rpx; top: 7rpx; left: 7rpx; background: currentColor; border-radius: 50%; }
.icon-import::before { width: 32rpx; height: 16rpx; border: 3rpx solid currentColor; border-top: 0; left: 3rpx; bottom: 0; border-radius: 0 0 6rpx 6rpx; }
.icon-import::after { width: 19rpx; height: 19rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; top: 1rpx; left: 10rpx; transform: rotate(45deg); }
.icon-chart { border-bottom: 3rpx solid currentColor; border-left: 3rpx solid currentColor; border-radius: 0 0 0 3rpx; }
.icon-chart::before { width: 5rpx; height: 16rpx; background: currentColor; bottom: 5rpx; left: 7rpx; box-shadow: 10rpx -6rpx 0 currentColor, 20rpx -12rpx 0 currentColor; }
.icon-restore { border: 3rpx solid currentColor; border-radius: 50%; border-left-color: transparent; transform: rotate(-30deg); }
.icon-restore::before { width: 12rpx; height: 12rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; left: -3rpx; top: 11rpx; }
.icon-restore::after { width: 3rpx; height: 13rpx; background: currentColor; left: 15rpx; top: 6rpx; }
.icon-palette { border: 3rpx solid currentColor; border-radius: 50% 50% 12rpx 50%; }
.icon-palette::before { width: 5rpx; height: 5rpx; border-radius: 50%; background: currentColor; top: 6rpx; left: 7rpx; box-shadow: 12rpx 2rpx 0 currentColor, -2rpx 12rpx 0 currentColor; }
.icon-shield { width: 31rpx; margin: 0 3rpx; border: 3rpx solid currentColor; border-radius: 6rpx 6rpx 16rpx 16rpx; }
.icon-shield::after { width: 14rpx; height: 8rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); left: 6rpx; top: 11rpx; }
.icon-chat { border: 3rpx solid currentColor; height: 30rpx; border-radius: 8rpx; }
.icon-chat::before { width: 10rpx; height: 10rpx; border-left: 3rpx solid currentColor; left: 4rpx; bottom: -10rpx; transform: skewY(-30deg); }
.icon-chat::after { width: 20rpx; border-top: 3rpx solid currentColor; top: 11rpx; left: 6rpx; }
.icon-chevron::after { width: 12rpx; height: 12rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(45deg); left: 10rpx; top: 12rpx; }
.icon-search::before { width: 25rpx; height: 25rpx; border: 3rpx solid currentColor; border-radius: 50%; top: 1rpx; left: 1rpx; }
.icon-search::after { width: 16rpx; border-top: 3rpx solid currentColor; top: 27rpx; left: 22rpx; transform: rotate(45deg); }
.dark .card { border-color: #2c3831; }
@media (prefers-color-scheme: dark) {
  page { background: #111916; color: #e5eee9; }
}
