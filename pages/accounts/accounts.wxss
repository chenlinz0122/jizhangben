page {
  background: #f4f6f5;
}

.accounts-page {
  --page-bg: #f4f6f5;
  --card-bg: #ffffff;
  --line: #e3eae6;
  --text: #24352e;
  --muted: #738078;
  --soft: #f0f4f2;
  --tint: var(--brand-soft, #e7f5ef);
  --accent: var(--brand, #17806b);
  --accent-ink: var(--brand-ink, #0f5f50);
  --danger: #bd4848;
  --danger-bg: #fff0ef;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  color: var(--text);
  background: var(--page-bg);
}

.accounts-page.dark {
  --page-bg: #141b18;
  --card-bg: #1e2823;
  --line: #34423a;
  --text: #e2eae5;
  --muted: #a7b5ad;
  --soft: #2a3630;
  --tint: #243f34;
  --accent: #81c7a9;
  --accent-ink: #a1dbbe;
  --danger: #f0a3a3;
  --danger-bg: #402827;
}

.accounts-page.dark.theme-ink {
  --tint: #263949;
  --accent: #94bddf;
  --accent-ink: #b1d1ec;
}

.accounts-page.dark.theme-amber {
  --tint: #443529;
  --accent: #e0b389;
  --accent-ink: #efc79f;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 26rpx;
}

.heading-copy,
.form-heading-copy,
.error-copy,
.switch-copy,
.account-identity {
  flex: 1;
  min-width: 0;
}

.page-title,
.form-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.page-subtitle,
.form-subtitle {
  display: block;
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.plain-button,
.primary-button,
.text-button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  font-family: inherit;
  font-weight: 400;
  line-height: 1.5;
  text-align: center;
}

.plain-button::after,
.primary-button::after,
.text-button::after {
  border: 0;
}

.plain-button.is-off,
.primary-button.is-off,
.text-button.is-off {
  opacity: 0.5;
}

.button-pressed {
  opacity: 0.68;
}

.add-button {
  flex: none;
  margin-left: 20rpx;
  padding: 15rpx 23rpx;
  border: 2rpx solid var(--accent);
  border-radius: 18rpx;
  background: var(--tint);
  color: var(--accent-ink);
  font-size: 25rpx;
  font-weight: 500;
}

.worth-card {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--hero-bg, linear-gradient(150deg, #1a8f76, #12695a));
  box-shadow: var(--hero-shadow, 0 14rpx 30rpx rgba(18, 105, 90, 0.18));
  color: #ffffff;
}

.dark .worth-card {
  background: var(--hero-bg-dark, linear-gradient(150deg, #145247, #0c3730));
  box-shadow: none;
}

.worth-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.worth-label {
  font-size: 25rpx;
  font-weight: 500;
}

.worth-scope {
  padding: 7rpx 13rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 20rpx;
}

.worth-value {
  display: block;
  margin-top: 15rpx;
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.worth-value.is-negative {
  color: #ffe3df;
}

.worth-note {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  line-height: 1.6;
}

.error-banner {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #efc9c5;
  border-radius: 20rpx;
  background: var(--danger-bg);
  color: var(--danger);
}

.error-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
}

.error-message {
  display: block;
  margin-top: 5rpx;
  font-size: 21rpx;
  line-height: 1.6;
}

.retry-button {
  flex: none;
  margin-left: 18rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid currentColor;
  border-radius: 14rpx;
  color: inherit;
  font-size: 22rpx;
}

.empty-state {
  margin-top: 26rpx;
  padding: 58rpx 36rpx 38rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--card-bg);
  text-align: center;
}

.empty-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: var(--tint);
  color: var(--accent-ink);
  font-size: 42rpx;
  font-weight: 600;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-description {
  display: block;
  max-width: 520rpx;
  margin: 15rpx auto 30rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.75;
}

.primary-button {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.dark .primary-button {
  color: #13231c;
}

.text-button {
  display: block;
  margin: 22rpx auto 0;
  padding: 10rpx 16rpx;
  background: transparent;
  color: var(--accent-ink);
  font-size: 24rpx;
}

.list-section {
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.section-note {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 400;
}

.account-card {
  margin-bottom: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--card-bg);
  overflow: hidden;
}

.account-main {
  display: flex;
  align-items: center;
  padding: 26rpx 26rpx 20rpx;
}

.account-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  background: var(--soft);
  color: var(--muted);
  font-size: 31rpx;
  font-weight: 600;
  flex: none;
}

.badge-cash {
  background: #fff2df;
  color: #9b6327;
}

.badge-bank {
  background: #eaf1fb;
  color: #376a9b;
}

.badge-wallet {
  background: #e5f5ed;
  color: #237451;
}

.badge-credit {
  background: #f8e9ed;
  color: #a64d68;
}

.dark .badge-cash {
  background: #443729;
  color: #e6bc8f;
}

.dark .badge-bank {
  background: #293b4d;
  color: #a6c7e6;
}

.dark .badge-wallet {
  background: #253e32;
  color: #9bd5b5;
}

.dark .badge-credit {
  background: #432d36;
  color: #e5adbf;
}

.account-name {
  display: block;
  max-width: 250rpx;
  overflow: hidden;
  color: var(--text);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-type {
  display: block;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.balance-block {
  flex: none;
  margin-left: 16rpx;
  text-align: right;
}

.balance-label {
  display: block;
  color: var(--muted);
  font-size: 20rpx;
}

.balance-value {
  display: block;
  margin-top: 6rpx;
  color: var(--text);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.balance-value.is-negative {
  color: var(--danger);
}

.account-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 26rpx;
  padding: 16rpx 0 18rpx;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.account-meta-left {
  min-width: 0;
  margin-right: 16rpx;
}

.account-meta-left text {
  display: block;
}

.account-meta .rate-line {
  margin-top: 4rpx;
  font-size: 20rpx;
}

.account-meta .included {
  color: var(--accent-ink);
}

.account-meta .excluded {
  color: var(--muted);
}

.rate-history {
  margin: 0 26rpx;
  padding: 16rpx 0 10rpx;
  border-top: 1rpx solid var(--line)
}

.rate-history-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 23rpx;
  font-weight: 500
}

.rate-history-note {
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 400
}

.rate-history-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid var(--line)
}

.rate-history-row:last-child {
  border-bottom: 0
}

.rate-history-time {
  flex: none;
  width: 154rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5
}

.rate-history-change {
  flex: 1;
  min-width: 0
}

.rate-history-value,
.rate-history-rate {
  display: block;
  line-height: 1.5;
  word-break: break-all
}

.rate-history-value {
  color: var(--accent-ink);
  font-size: 23rpx
}

.rate-history-rate {
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 19rpx
}

.account-actions {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.row-action {
  flex: 1;
  min-height: 76rpx;
  background: transparent;
  color: var(--accent-ink);
  font-size: 24rpx;
}

.row-action + .row-action {
  border-left: 1rpx solid var(--line);
}

.danger-action {
  color: var(--danger);
}

.page-footnote {
  display: block;
  padding: 14rpx 12rpx 0;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.75;
}

.form-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
}

.form-sheet {
  width: 100%;
  max-height: 90vh;
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 30rpx 30rpx 0 0;
  background: var(--card-bg);
  color: var(--text);
  box-shadow: 0 -16rpx 50rpx rgba(0, 0, 0, 0.16);
}

.form-heading {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 32rpx 25rpx;
  border-bottom: 1rpx solid var(--line);
}

.close-button {
  flex: none;
  margin-left: 18rpx;
  padding: 10rpx 0 10rpx 20rpx;
  background: transparent;
  color: var(--muted);
  font-size: 24rpx;
}

.form-body {
  padding: 8rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
}

.field-group {
  padding: 24rpx 0 4rpx;
}

.field-label {
  display: block;
  color: var(--text);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
}

.field-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 28rpx;
}

.input-placeholder {
  color: var(--muted);
}

.currency-picker {
  display: flex;
  align-items: center;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 14rpx -6rpx 0;
}

.type-option {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  margin: 6rpx;
  padding: 19rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--soft);
  color: var(--text);
  text-align: left;
}

.type-option.is-selected {
  border-color: var(--accent);
  background: var(--tint);
  color: var(--accent-ink);
}

.type-name,
.type-note {
  display: block;
}

.type-name {
  font-size: 26rpx;
  font-weight: 500;
}

.type-note {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.is-selected .type-note {
  color: var(--accent-ink);
}

.amount-input-wrap {
  position: relative;
}

.currency-mark {
  position: absolute;
  left: 24rpx;
  top: 31rpx;
  z-index: 1;
  color: var(--muted);
  font-size: 29rpx;
}

.amount-input {
  padding-left: 58rpx;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.65;
}

.credit-hint {
  color: var(--danger);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 27rpx 0 10rpx;
}

.switch-row switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(0.82);
  transform-origin: right center;
}

.form-error {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--danger-bg);
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.6;
}

.save-button {
  margin-top: 28rpx;
}

.mapping-section {
  padding-bottom: 12rpx;
}

.mapping-intro {
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--card-bg);
}

.mapping-intro-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.mapping-intro-note {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}

.mapping-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  color: var(--accent-ink);
  font-size: 22rpx;
}

.mapping-stats text {
  margin: 0 18rpx 8rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: var(--tint);
}

.mapping-error {
  margin: 0 0 18rpx;
}

.mapping-editor,
.mapping-preview {
  margin-bottom: 18rpx;
  padding: 4rpx 26rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--card-bg);
}

.mapping-preview {
  padding-top: 24rpx;
}

.mapping-picker {
  display: flex;
  align-items: center;
}

.mapping-picker.is-placeholder {
  color: var(--muted);
}

.mapping-preview-result,
.mapping-preview-error {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.65;
}

.mapping-preview-result {
  color: var(--accent-ink);
}

.mapping-preview-error {
  color: var(--danger);
}

.mapping-empty {
  padding: 30rpx 26rpx;
  border: 1rpx dashed var(--line);
  border-radius: 20rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}

.mapping-card {
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--card-bg);
  overflow: hidden;
}

.mapping-card.is-missing {
  border-color: var(--danger);
}

.mapping-rule-main {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.mapping-rule-copy {
  flex: 1;
  min-width: 0;
}

.mapping-keyword,
.mapping-target {
  display: block;
  line-height: 1.5;
  word-break: break-all;
}

.mapping-keyword {
  font-size: 29rpx;
  font-weight: 600;
}

.mapping-target {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.mapping-rule-main switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(0.82);
  transform-origin: right center;
}

.mapping-rule-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 24rpx;
  padding: 14rpx 0 18rpx;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.55;
}

.mapping-rule-meta .included {
  color: var(--accent-ink);
}

.mapping-rule-actions {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.mapping-apply {
  margin-top: 22rpx;
}

.mapping-footnote {
  display: block;
  padding: 14rpx 10rpx 0;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.7;
}

.mapping-progress {
  position: fixed;
  left: 50%;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 120;
  max-width: 80vw;
  padding: 20rpx 28rpx;
  transform: translateX(-50%);
  border-radius: 18rpx;
  background: rgba(20, 32, 27, 0.9);
  color: #ffffff;
  font-size: 23rpx;
}

.mapping-confirm-mask {
  z-index: 130;
}

.mapping-confirm-hint {
  margin: 22rpx 0 18rpx;
}

.mapping-choice {
  width: 100%;
  margin-top: 12rpx;
  padding: 23rpx;
  border: 2rpx solid var(--accent);
  border-radius: 18rpx;
  background: var(--tint);
  color: var(--accent-ink);
  font-size: 27rpx;
}

.mapping-skip {
  margin-top: 18rpx;
  color: var(--muted);
}

@media (prefers-color-scheme: dark) {
  page {
    background: #141b18;
  }
}
