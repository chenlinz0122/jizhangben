<view class="theme-{{themeKey}} page {{dark ? 'dark' : ''}}">
  <view class="seg">
    <text class="segi {{type === 'expense' ? 'on' : ''}}" data-t="expense" bindtap="switchType">支出</text>
    <text class="segi {{type === 'income' ? 'on' : ''}}" data-t="income" bindtap="switchType">收入</text>
    <text class="segi {{type === 'transfer' ? 'on' : ''}}" data-t="transfer" bindtap="switchType">转账</text>
  </view>

  <view class="amtbox">
    <text class="cny">¥</text>
    <input class="amtinput" type="digit" value="{{amount}}" bindinput="onAmount"
           placeholder="0.00" placeholder-class="amph" />
  </view>

  <view class="card">
    <view class="title">{{type === 'transfer' ? '资金流水类型' : '分类'}}</view>
    <view class="cats">
      <text class="chip {{cat === item.name ? 'on' : ''}}" wx:for="{{cats}}" wx:key="name"
            data-cat="{{item.name}}" bindtap="pickCat">{{item.icon}} {{item.name}}</text>
    </view>
    <view class="muted" wx:if="{{type === 'transfer'}}">账户之间的划转，不计入收支统计</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="flabel">日期</text>
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
        <view class="fvalue">{{date}} ›</view>
      </picker>
    </view>
    <view class="field">
      <text class="flabel">交易对方</text>
      <input class="finput" value="{{merchant}}" bindinput="onMerchant" placeholder="可不填" placeholder-class="ph" />
    </view>
    <view class="sugs" wx:if="{{suggestions.length > 0}}">
      <text class="sug" wx:for="{{suggestions}}" wx:key="*this" data-m="{{item}}" bindtap="pickSuggestion">{{item}}</text>
    </view>
    <view class="field">
      <text class="flabel">备注</text>
      <input class="finput" value="{{note}}" bindinput="onNote" placeholder="可不填" placeholder-class="ph" />
    </view>
  </view>

  <view class="savebtn btn" bindtap="save">保存</view>
</view>
