.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.seg {
  display: flex;
  background: #ffffff;
  padding: 20rpx 32rpx;
  gap: 16rpx;
}

.segi {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8b9198;
  border-radius: 14rpx;
  background: #f5f6f7;
}

.segi.on {
  background: #e3f0ec;
  color: var(--brand, #17806b);
  font-weight: 600;
}

.amtbox {
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 44rpx;
}

.cny {
  font-size: 44rpx;
  color: #1c1f23;
  margin-right: 12rpx;
}

.amtinput {
  flex: 1;
  font-size: 64rpx;
  font-weight: 600;
}

.amph {
  color: #d3d8db;
}

.currency-strip {
  padding: 18rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #f0f2f3;
  background: #ffffff;
}

.currency-caption,
.currency-preview {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
}

.currency-caption { color: #8b9198; }
.currency-preview { margin-top: 4rpx; color: var(--brand, #17806b); }
.currency-note { padding: 8rpx 0 18rpx; line-height: 1.6; }

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  font-size: 26rpx;
  color: #5a6169;
  background: #f5f6f7;
  border-radius: 24rpx;
  padding: 14rpx 26rpx;
}

.chip.on {
  background: var(--brand, #17806b);
  color: #ffffff;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.field:last-child {
  border-bottom: none;
}

.flabel {
  width: 150rpx;
  font-size: 26rpx;
  color: #5a6169;
  flex: none;
}

.fvalue {
  font-size: 27rpx;
  color: #1c1f23;
}

.finput {
  flex: 1;
  font-size: 27rpx;
  text-align: right;
}

.ph {
  color: #b1b7bd;
}

.savebtn {
  margin: 32rpx 24rpx 0;
}

.savebtn.saving {
  opacity: 0.6;
}

.sugs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 4rpx 0 12rpx;
}

.sug {
  font-size: 24rpx;
  color: var(--brand, #17806b);
  background: #e3f0ec;
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
}

/* ---------- 系统深色 ---------- */
.dark { background: #111916; color: #e5eee9; }
.dark .card { background: #1b2421; border-color: #2c3831; }
.dark .hint, .dark .muted, .dark .tip, .dark .li, .dark .foot, .dark .note, .dark .h2 { color: #9fb0a8; }
.dark .title, .dark .ct, .dark .h1 { color: #e5eee9; }
.dark .ipt, .dark .ta { background: #141b18; border-color: #2c3831; color: #e5eee9; }
.dark .btn.plain { background: #1b2421; border-color: #2c3831; color: #e5eee9; }
.dark .divider { background: #2c3831; }

/* 深色：页面特有的底色 */
.dark .seg, .dark .amtbox, .dark .currency-strip { background: #1b2421; border-color: #2c3831; }
.dark .currency-caption, .dark .currency-note { color: #a0b0a7; }
.dark .currency-preview { color: #a4d4c2; }
.dark .cny, .dark .fvalue { color: #e5eee9; }
.dark .segi, .dark .chip { background: #24332c; }
