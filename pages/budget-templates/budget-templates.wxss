.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f3f5f6;
  color: #1c1f23;
}

.hero {
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: var(--hero-bg, linear-gradient(160deg, #1a8f76, #12695a));
  color: #ffffff;
  box-shadow: var(--hero-shadow, 0 12rpx 28rpx rgba(18, 105, 90, 0.18));
}
.hero-kicker { font-size: 20rpx; letter-spacing: 4rpx; opacity: 0.65; }
.hero-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; font-size: 26rpx; opacity: 0.82; }
.hero-note { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.18); font-size: 22rpx; line-height: 1.6; opacity: 0.78; }
.dark .hero { background: var(--hero-bg-dark, linear-gradient(160deg, #145247, #0c3730)); }

.notice {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--brand-line, #cfe0da);
  border-radius: 22rpx;
  background: var(--brand-soft, #e7f5ef);
}
.notice-title { color: var(--brand-ink, #0f5f50); font-size: 27rpx; font-weight: 600; }
.notice-text { margin-top: 8rpx; color: #547269; font-size: 23rpx; line-height: 1.65; }
.section-head { margin: 34rpx 6rpx 18rpx; }
.title { font-size: 31rpx; font-weight: 600; }
.muted { color: #8b9198; font-size: 23rpx; }

.template-grid { display: flex; flex-direction: column; gap: 18rpx; }
.template-card, .custom-card {
  position: relative;
  padding: 28rpx;
  border: 2rpx solid #e6ece8;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}
.template-card.selected, .custom-card.selected { border-color: var(--brand, #17806b); background: var(--brand-soft, #e7f5ef); }
.template-top, .between { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.template-name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; }
.badge { flex: none; padding: 8rpx 16rpx; border-radius: 18rpx; background: #f1f3f4; color: #6f787f; font-size: 21rpx; }
.template-money { margin-top: 16rpx; color: var(--brand-ink, #0f5f50); font-size: 40rpx; font-weight: 700; }
.custom-card .template-money { flex: none; margin-top: 0; font-size: 30rpx; }
.template-desc { margin-top: 12rpx; color: #6f787f; font-size: 22rpx; line-height: 1.65; word-break: break-all; }
.selected-mark { position: absolute; right: 28rpx; bottom: 22rpx; color: var(--brand-ink, #0f5f50); font-size: 21rpx; }
.custom-head { margin-bottom: 0; }
.card { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid #e6ece8; border-radius: 28rpx; background: #ffffff; }
.empty { padding: 52rpx 20rpx; color: #9aa0a6; text-align: center; font-size: 25rpx; line-height: 1.6; }
.item-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid #eef1ef; }
.action { padding: 14rpx 24rpx; border-radius: 16rpx; background: #f4f6f5; color: #4d5d57; font-size: 24rpx; text-align: center; }
.action.danger { background: #fff0ee; color: #c34e45; }

.preview-total { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 24rpx; }
.big-money { margin-top: 8rpx; color: var(--brand-ink, #0f5f50); font-size: 52rpx; font-weight: 700; }
.current-note { color: #8b9198; font-size: 22rpx; line-height: 1.6; text-align: right; }
.field { display: flex; align-items: center; gap: 16rpx; min-height: 92rpx; border-bottom: 1rpx solid #eef1ef; }
.income-field { margin-top: 22rpx; }
.flabel { flex: none; width: 230rpx; color: #5d6863; font-size: 25rpx; }
.finput { flex: 1; min-width: 0; font-size: 27rpx; text-align: right; }
.ph { color: #b1b8b4; }
.preview-metrics { display: flex; margin-top: 22rpx; padding: 22rpx 0; border-radius: 20rpx; background: #f6f8f7; }
.metric { flex: 1; min-width: 0; padding: 0 12rpx; text-align: center; }
.metric-value { display: block; font-size: 27rpx; font-weight: 600; word-break: break-all; }
.metric-label { display: block; margin-top: 8rpx; color: #8b9198; font-size: 20rpx; }
.metric-value.warning { color: #c34e45; }
.preview-rows { margin-top: 14rpx; }
.preview-row { padding: 16rpx 0; }
.preview-row-main { display: flex; justify-content: space-between; font-size: 24rpx; }
.progress { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 8rpx; background: #edf1ef; }
.progress-in { height: 100%; border-radius: 8rpx; background: var(--brand, #17806b); }
.tip { margin-top: 16rpx; color: #87918c; font-size: 22rpx; line-height: 1.65; }
.top-tip { margin: 0 0 10rpx; }
.btn { margin-top: 26rpx; padding: 24rpx; border-radius: 20rpx; text-align: center; font-size: 29rpx; font-weight: 600; box-sizing: border-box; }
.btn.primary { background: var(--hero-bg, linear-gradient(135deg, #1a8f76, #17806b)); color: #ffffff; box-shadow: var(--hero-shadow, 0 10rpx 24rpx rgba(23, 128, 107, 0.18)); }
.btn.disabled { background: #c7cecb; color: #f5f7f6; box-shadow: none; }
.amount-field .finput { font-size: 39rpx; font-weight: 600; }
.cny { color: #34463e; font-size: 32rpx; font-weight: 600; }
.form-label { padding-top: 20rpx; color: #37433e; font-size: 27rpx; font-weight: 600; }
.budget-label { padding-bottom: 8rpx; }
.budget-label .muted { margin-left: 12rpx; font-size: 21rpx; font-weight: 400; }
.budget-row { display: flex; align-items: center; gap: 20rpx; min-height: 84rpx; border-bottom: 1rpx solid #eef1ef; }
.budget-row:last-of-type { border-bottom: 0; }
.budget-category { flex: 1; font-size: 25rpx; }
.budget-input-wrap { display: flex; align-items: center; justify-content: flex-end; width: 260rpx; }
.budget-input { max-width: 210rpx; }
.backup-actions { display: flex; gap: 18rpx; margin-top: 24rpx; }
.action.wide { flex: 1; padding: 22rpx 10rpx; background: var(--brand-soft, #e7f5ef); color: var(--brand-ink, #0f5f50); }
.load-draft { margin-top: 20rpx; text-align: center; }
.foot { padding: 34rpx 0 10rpx; color: #a0a7ac; text-align: center; font-size: 20rpx; line-height: 1.6; }
.card-hover { opacity: 0.78; }

.dark { background: #111916; color: #e5eee9; }
.dark .template-card, .dark .custom-card, .dark .card, .dark .sheet { background: #1b2421; border-color: #2c3831; }
.dark .template-card.selected, .dark .custom-card.selected { background: #172b24; border-color: #397c68; }
.dark .notice { background: #172b24; border-color: #315246; }
.dark .notice-title, .dark .template-money, .dark .big-money, .dark .selected-mark { color: #93cdb8; }
.dark .notice-text, .dark .template-desc, .dark .flabel, .dark .form-label, .dark .budget-category { color: #a8b8b0; }
.dark .muted, .dark .current-note, .dark .metric-label, .dark .tip, .dark .foot, .dark .empty, .dark .close { color: #8fa199; }
.dark .badge, .dark .action, .dark .preview-metrics { background: #24332c; }
.dark .badge, .dark .action { color: #c2d2ca; }
.dark .action.danger { background: #3a2523; color: #efa59d; }
.dark .action.wide { background: #254437; color: #a9d7c7; }
.dark .field, .dark .budget-row, .dark .item-actions { border-color: #2c3831; }
.dark .progress { background: #314139; }
.dark .cny, .dark .finput { color: #e5eee9; }
.dark .btn.disabled { background: #394941; color: #84978e; }
.dark .metric-value.warning { color: #efa59d; }

.sheet-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(10, 18, 15, 0.5); }
.sheet { width: 100%; padding: 12rpx 28rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #ffffff; box-sizing: border-box; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto; border-radius: 8rpx; background: #d9dfdc; }
.sheet-head { padding: 24rpx 4rpx 16rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.close { padding: 10rpx 0 10rpx 24rpx; color: #7d8782; font-size: 26rpx; }
.sheet-content { padding: 30rpx 4rpx 20rpx; color: #6f787f; font-size: 26rpx; line-height: 1.7; }
.dark .sheet-content { color: #a8b8b0; }
.dark .sheet-handle { background: #314139; }

@media (prefers-color-scheme: dark) {
  .page:not(.dark) { background: #f3f5f6; color: #1c1f23; }
}
