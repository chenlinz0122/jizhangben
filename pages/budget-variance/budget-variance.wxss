.bv-page {
  --bv-bg: #f3f5f4;
  --bv-surface: #ffffff;
  --bv-text: #1d2925;
  --bv-muted: #77827d;
  --bv-faint: #9aa39f;
  --bv-line: #e6ece9;
  --bv-track: #edf1ef;
  --bv-brand: var(--brand, #17806b);
  --bv-soft: var(--brand-soft, #e7f5ef);
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(18rpx + env(safe-area-inset-top)) 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bv-bg);
  color: var(--bv-text);
}

.bv-page.dark {
  --bv-bg: #111916;
  --bv-surface: #1b2421;
  --bv-text: #e5eee9;
  --bv-muted: #9aa9a2;
  --bv-faint: #75857d;
  --bv-line: #2c3831;
  --bv-track: #2a3731;
  --bv-soft: #223a32;
}

.bv-back {
  display: inline-block;
  margin: 4rpx 0 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--bv-surface);
  color: var(--bv-brand);
  font-size: 24rpx;
}

.bv-header,
.bv-card,
.bv-footer {
  margin-bottom: 24rpx;
}

.bv-title-row,
.bv-month-row,
.bv-overview-head,
.bv-card-head,
.bv-cat-head,
.bv-cat-meta,
.bv-overview-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bv-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.bv-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--bv-muted);
  font-size: 24rpx;
}

.bv-copy-mini {
  flex: none;
  margin-left: 20rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid var(--bv-line);
  border-radius: 999rpx;
  background: var(--bv-surface);
  color: var(--bv-brand);
  font-size: 23rpx;
}

.bv-month-row {
  margin-top: 26rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--bv-line);
  border-radius: 22rpx;
  background: var(--bv-surface);
}

.bv-month-row picker {
  flex: 1;
}

.bv-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  color: var(--bv-brand);
  font-size: 42rpx;
  border-radius: 18rpx;
}

.bv-arrow.off {
  color: var(--bv-faint);
  opacity: 0.45;
}

.bv-month {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.bv-chevron {
  color: var(--bv-muted);
  font-size: 24rpx;
}

.bv-current {
  flex: none;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: var(--bv-soft);
  color: var(--bv-brand);
  font-size: 22rpx;
}

.bv-scope {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--bv-surface);
  border: 1rpx solid var(--bv-line);
}

.bv-scope-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--bv-muted);
  font-size: 22rpx;
}

.bv-scope-switch {
  display: flex;
  padding: 5rpx;
  border-radius: 18rpx;
  background: var(--bv-track);
}

.bv-scope-item {
  flex: 1;
  padding: 13rpx 8rpx;
  text-align: center;
  border-radius: 14rpx;
  color: var(--bv-muted);
  font-size: 23rpx;
}

.bv-scope-item.on {
  background: var(--bv-surface);
  color: var(--bv-brand);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(23, 50, 41, 0.08);
}

.bv-error {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #fff0ee;
  color: #b63d35;
  font-size: 25rpx;
  line-height: 1.6;
}

.bv-overview {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: var(--hero-bg, linear-gradient(160deg, #1a8f76, #12695a));
  box-shadow: var(--hero-shadow, 0 14rpx 32rpx rgba(18, 105, 90, 0.18));
  color: #ffffff;
}

.dark .bv-overview {
  background: var(--hero-bg-dark, linear-gradient(160deg, #145247, #0c3730));
  box-shadow: none;
}

.bv-section-light {
  font-size: 27rpx;
  font-weight: 600;
}

.bv-status {
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.bv-status.over,
.bv-cat-status.over {
  color: #ffffff;
}

.bv-status.over {
  background: #c94e45;
}

.bv-amount-label {
  display: block;
  margin-top: 30rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
}

.bv-amount {
  display: block;
  margin-top: 6rpx;
  font-size: 60rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.bv-amount.negative {
  color: #b9ecf5;
}

.bv-summary-note {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 21rpx;
  line-height: 1.55;
}

.bv-progress,
.bv-cat-progress {
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.bv-progress {
  height: 14rpx;
  margin-top: 26rpx;
}

.bv-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #ffffff;
  transition: width 0.2s ease;
}

.bv-progress-fill.over {
  background: #ffb4ac;
}

.bv-progress-fill.near {
  background: #ffe0a3;
}

.bv-progress-fill.none {
  background: rgba(255, 255, 255, 0.6);
}

.bv-metrics {
  display: flex;
  margin-top: 28rpx;
}

.bv-metric {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.18);
}

.bv-metric:first-child {
  padding-left: 0;
  border-left: 0;
}

.bv-metric:last-child {
  padding-right: 0;
}

.bv-metric-label {
  display: block;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
}

.bv-metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bv-metric-value.danger {
  color: #ffd0ca;
}

.bv-overview-foot {
  gap: 16rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.bv-settings {
  flex: none;
  color: #ffffff;
}

.bv-card {
  padding: 30rpx;
  border: 1rpx solid var(--bv-line);
  border-radius: 28rpx;
  background: var(--bv-surface);
}

.bv-card-head {
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.bv-card-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
}

.bv-card-sub {
  display: block;
  margin-top: 7rpx;
  color: var(--bv-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.bv-count {
  flex: none;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: var(--bv-soft);
  color: var(--bv-brand);
  font-size: 21rpx;
}

.bv-empty {
  padding: 42rpx 16rpx;
  text-align: center;
  color: var(--bv-muted);
  font-size: 25rpx;
}

.bv-empty-sub {
  display: block;
  margin-top: 10rpx;
  color: var(--bv-faint);
  font-size: 21rpx;
}

.bv-trend-card {
  padding-right: 0;
  padding-left: 0;
  overflow: hidden;
}

.bv-trend-card .bv-card-head {
  padding: 0 30rpx;
}

.bv-trend-scroll {
  width: 100%;
  white-space: nowrap;
}

.bv-trend-table {
  min-width: 780rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.bv-trend-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-top: 1rpx solid var(--bv-line);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.bv-trend-row.active {
  background: var(--bv-soft);
}

.bv-trend-head {
  min-height: 58rpx;
  border-top: 0;
  color: var(--bv-muted);
  font-size: 20rpx;
}

.bv-trend-month,
.bv-trend-budget,
.bv-trend-spent,
.bv-trend-variance,
.bv-trend-usage,
.bv-trend-status {
  flex: none;
  box-sizing: border-box;
  padding-right: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bv-trend-month { width: 104rpx; }
.bv-trend-budget { width: 116rpx; }
.bv-trend-spent { width: 140rpx; }
.bv-trend-variance { width: 116rpx; }
.bv-trend-usage { width: 132rpx; }
.bv-trend-status { width: 102rpx; padding-right: 0; }

.bv-trend-usage text {
  display: block;
}

.bv-trend-progress {
  overflow: hidden;
  width: 92rpx;
  height: 8rpx;
  margin-top: 9rpx;
  border-radius: 999rpx;
  background: var(--bv-track);
}

.bv-trend-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--bv-brand);
}

.bv-trend-progress-fill.over {
  background: #d65349;
}

.bv-trend-progress-fill.near {
  background: #d69a35;
}

.bv-trend-progress-fill.none {
  background: var(--bv-faint);
}

.bv-trend-status {
  display: inline-block;
  width: auto;
  max-width: 102rpx;
  margin-right: 4rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: var(--bv-track);
  color: var(--bv-muted);
  font-size: 20rpx;
  text-align: center;
}

.bv-trend-status.over {
  background: #fbe5e2;
  color: #c3483f;
}

.bv-trend-status.near {
  background: #fff1d9;
  color: #a36b18;
}

.bv-trend-status.healthy {
  background: var(--bv-soft);
  color: var(--bv-brand);
}

.dark .bv-trend-status.over {
  background: #492d2a;
  color: #ffaea5;
}

.dark .bv-trend-status.near {
  background: #443a28;
  color: #f2cb84;
}

.bv-trend-note {
  display: block;
  margin: 18rpx 30rpx 0;
  color: var(--bv-faint);
  font-size: 20rpx;
  line-height: 1.6;
}

.bv-trend-budget.muted,
.bv-trend-variance.muted {
  color: var(--bv-faint);
}

.bv-trend-spent.refund {
  color: #287f9b;
}

.dark .bv-trend-spent.refund {
  color: #78cde3;
}

.bv-trend-variance.danger {
  color: #c3483f;
}

.dark .bv-trend-variance.danger {
  color: #ffaea5;
}

.bv-cat {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--bv-line);
}

.bv-cat:last-child {
  padding-bottom: 4rpx;
}

.bv-cat-name-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.bv-cat-icon {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
}

.dark .bv-cat-icon {
  opacity: 0.82;
}

.bv-cat-name-col {
  min-width: 0;
}

.bv-cat-name {
  display: block;
  max-width: 330rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 600;
}

.bv-cat-state {
  display: block;
  margin-top: 3rpx;
  color: var(--bv-faint);
  font-size: 20rpx;
}

.bv-cat-status {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: var(--bv-track);
  color: var(--bv-muted);
  font-size: 20rpx;
}

.bv-cat-status.over {
  background: #fbe5e2;
  color: #c3483f;
}

.bv-cat-status.near {
  background: #fff1d9;
  color: #a36b18;
}

.bv-cat-status.healthy {
  background: var(--bv-soft);
  color: var(--bv-brand);
}

.dark .bv-cat-status.over {
  background: #492d2a;
  color: #ffaea5;
}

.dark .bv-cat-status.near {
  background: #443a28;
  color: #f2cb84;
}

.bv-cat-numbers {
  display: flex;
  margin-top: 22rpx;
}

.bv-cat-number {
  flex: 1;
  min-width: 0;
}

.bv-number-label {
  display: block;
  color: var(--bv-muted);
  font-size: 20rpx;
}

.bv-number-value {
  display: block;
  margin-top: 7rpx;
  font-size: 25rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.align-right {
  text-align: right;
}

.bv-number-value.refund {
  color: #287f9b;
}

.dark .bv-number-value.refund {
  color: #78cde3;
}

.bv-number-value.danger {
  color: #c3483f;
}

.dark .bv-number-value.danger {
  color: #ffaea5;
}

.bv-cat-progress {
  height: 10rpx;
  margin-top: 20rpx;
  background: var(--bv-track);
}

.bv-cat-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.bv-cat-progress-fill.over {
  background: #d65349 !important;
}

.bv-cat-progress-fill.near {
  background: #d69a35 !important;
}

.bv-cat-progress-fill.none {
  background: var(--bv-faint) !important;
}

.bv-cat-meta {
  margin-top: 9rpx;
  color: var(--bv-faint);
  font-size: 20rpx;
}

.bv-advice {
  display: block;
  margin-top: 15rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--bv-bg);
  color: var(--bv-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.bv-suggestion {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 17rpx 0;
  border-top: 1rpx solid var(--bv-line);
}

.bv-suggestion-index {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bv-soft);
  color: var(--bv-brand);
  font-size: 21rpx;
  font-weight: 600;
}

.bv-suggestion-text {
  flex: 1;
  color: var(--bv-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.bv-btn {
  padding: 27rpx;
  border-radius: 22rpx;
  background: var(--hero-bg, linear-gradient(135deg, #1a8f76, #12695a));
  color: #ffffff;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}

.dark .bv-btn {
  background: var(--hero-bg-dark, linear-gradient(135deg, #145247, #0c3730));
}

.bv-btn.disabled {
  background: var(--bv-track);
  color: var(--bv-faint);
}

.bv-footer-note {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: var(--bv-faint);
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .bv-page:not(.dark) {
    --bv-bg: #111916;
    --bv-surface: #1b2421;
    --bv-text: #e5eee9;
    --bv-muted: #9aa9a2;
    --bv-faint: #75857d;
    --bv-line: #2c3831;
    --bv-track: #2a3731;
    --bv-soft: #223a32;
  }
}
