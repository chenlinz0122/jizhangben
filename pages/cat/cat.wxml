<view class="page">
  <view class="hero">
    <view class="htop">
      <text class="hcat">{{cat}}</text>
      <text class="hyear">{{year}} 年支出明细</text>
    </view>
    <text class="hnum">¥{{totalText}}</text>
    <view class="hfoot">
      <text>{{count}} 笔</text>
      <text class="hdot">·</text>
      <text>{{monthCount}} 个月</text>
      <text class="hdot">·</text>
      <text>月均 ¥{{avgText}}</text>
    </view>
    <view class="hfoot" wx:if="{{count > 0}}">
      <text>最大一笔 ¥{{maxText}}</text>
      <text class="hdot" wx:if="{{maxMerchant}}">·</text>
      <text class="hmerchant" wx:if="{{maxMerchant}}">{{maxMerchant}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{months.length === 0}}">
    <text>这一年没有「{{cat}}」的支出</text>
  </view>

  <view class="mblock" wx:for="{{months}}" wx:key="ym" wx:for-item="m">
    <view class="mhead">
      <text class="mlabel">{{m.label}}</text>
      <text class="msub">¥{{m.totalText}} · {{m.count}} 笔</text>
    </view>
    <view class="items">
      <view class="item" wx:for="{{m.items}}" wx:key="id">
        <view class="ileft">
          <text class="im">{{item.merchant}}</text>
          <text class="isub">{{item.dayText}} {{item.weekText}} · {{item.timeText}}<text wx:if="{{item.desc}}"> · {{item.desc}}</text></text>
        </view>
        <text class="iamt">-¥{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <view class="tip" wx:if="{{months.length > 0}}">按月分段，每段里从新到旧</view>
</view>
