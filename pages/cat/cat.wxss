.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 页面内返回按钮，压在 hero 顶部 */
.navback {
  position: absolute;
  left: 24rpx;
  top: 14rpx;
  z-index: 20;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  backdrop-filter: blur(6px);
}

/* ---------- 顶部合计 ---------- */
.hero {
  background: linear-gradient(160deg, #1a8f76 0%, #12695a 100%);
  padding: 68rpx 32rpx 34rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 105, 90, 0.18);
}

.htop {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.hcat {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.hyear {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hnum {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  margin-top: 14rpx;
  line-height: 1.2;
}

.hfoot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hdot {
  opacity: 0.6;
}

.hmerchant {
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 按月分段 ---------- */
.mblock {
  margin: 26rpx 24rpx 0;
}

.mhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 12rpx;
}

.mlabel {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b3136;
}

.msub {
  font-size: 21rpx;
  color: #a2a8ae;
}

.items {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(23, 128, 107, 0.06);
}

.item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.items .item:last-child {
  border-bottom: none;
}

.ileft {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.im {
  display: block;
  font-size: 28rpx;
  color: #2b3136;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.isub {
  display: block;
  font-size: 21rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.iamt {
  font-size: 30rpx;
  font-weight: 600;
  color: #d9433f;
  white-space: nowrap;
}

.iamt.inc {
  color: #1f7a4d;
}

/* ---------- 其它 ---------- */
.empty {
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  padding: 90rpx 40rpx;
  line-height: 1.8;
}

.tip {
  text-align: center;
  font-size: 20rpx;
  color: #b1b7bd;
  padding: 36rpx 0 0;
}

/* ---------- 单笔详情弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.22s ease-out;
  z-index: 101;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.sheet.up {
  transform: translateY(0);
}

.sheethd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 32rpx 22rpx;
  border-bottom: 1rpx solid #f1f3f4;
}

.shleft {
  flex: 1;
  min-width: 0;
}

.shm {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b3136;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.shamt {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #d9433f;
  margin-top: 8rpx;
}

.shamt.inc {
  color: #1f7a4d;
}

.shclose {
  font-size: 26rpx;
  color: #8b9198;
  padding-left: 20rpx;
}

.shbody {
  padding: 8rpx 32rpx 0;
}

.shrow {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6f7f8;
}

.shrow:last-child {
  border-bottom: none;
}

.shk {
  width: 96rpx;
  flex: none;
  font-size: 23rpx;
  color: #9aa0a6;
}

.shv {
  flex: 1;
  font-size: 25rpx;
  color: #2b3136;
  word-break: break-all;
}

.shn {
  display: block;
  padding: 22rpx 32rpx 6rpx;
  font-size: 20rpx;
  color: #a2a8ae;
  line-height: 1.6;
}
