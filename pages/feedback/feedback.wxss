/* 意见反馈页 */

.page {
  padding: 24rpx 28rpx 60rpx;
}

.chips {
  display: flex;
  margin: 4rpx 0 24rpx;
}

.chip {
  padding: 12rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: #f4f6f7;
  color: #6b737a;
  font-size: 26rpx;
}

.chip.on {
  background: #e8f5f0;
  color: var(--brand, #17806b);
  font-weight: 600;
}

.ta {
  width: 100%;
  min-height: 200rpx;
  background: #f4f6f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.counter {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #b0b6bb;
}

.shot-row {
  display: flex;
}

.shot {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f4f6f7;
}

.shot image {
  width: 100%;
  height: 100%;
}

.shot.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d5dcdf;
}

.plus {
  font-size: 40rpx;
  color: #b0b6bb;
  line-height: 1;
}

.add-txt {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.shot-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 30rpx;
  border-bottom-left-radius: 14rpx;
}

.line-input {
  height: 88rpx;
  background: #f4f6f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.btn {
  margin-top: 12rpx;
}

.err {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #d9433f;
  text-align: center;
}

.foot {
  display: block;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #b0b6bb;
  text-align: center;
  line-height: 1.6;
}
