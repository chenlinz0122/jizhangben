<view class="home-page theme-{{themeKey}} {{dark ? 'dark' : ''}}">
  <view class="home-heading">
    <view class="heading-copy">
      <text class="eyebrow">把日子记清楚</text>
      <text class="greeting">{{greeting}}{{isLogin ? '，' + nick : ''}}</text>
    </view>
    <button class="profile-button" bindtap="goMine" aria-label="前往我的">
      <image wx:if="{{avatar}}" class="profile-image" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="ui-icon icon-user"></view>
    </button>
  </view>

  <view class="balance-card">
    <view class="balance-top">
      <view class="month-picker">
        <view class="month-arrow" hover-class="arrow-tap" bindtap="prevMonth">‹</view>
        <picker mode="date" fields="month" value="{{ym}}" end="{{maxYm}}" bindchange="pickMonth">
          <view class="month-value">{{monthText}}</view>
        </picker>
        <view class="month-arrow {{!canNext ? 'off' : ''}}" hover-class="none" bindtap="nextMonth">›</view>
      </view>
      <button wx:if="{{!isCurrent}}" class="current-button" bindtap="currentMonth">回本月</button>
      <text wx:else class="month-badge">本月</text>
    </view>
    <text class="balance-label">{{scopeLabel ? scopeLabel + ' · ' : ''}}收支结余</text>
    <view class="balance-value"><text class="currency">{{s.netSign}}¥</text><text>{{s.netText}}</text></view>
    <view class="balance-grid">
      <view class="balance-metric"><text class="metric-label">入账</text><text class="metric-number">¥{{s.incomeText}}</text></view>
      <view class="balance-metric"><text class="metric-label">{{s.refundOut ? '净支出' : '支出'}}</text><text class="metric-number">¥{{s.expenseText}}</text></view>
      <view class="balance-metric count-metric"><text class="metric-label">记录</text><text class="metric-number">{{s.count}}<text class="unit"> 笔</text></text></view>
    </view>
    <view class="refund-line" wx:if="{{s.refundText !== '0.00'}}" bindtap="toggleRefund">
      <text>退款 ¥{{s.refundText}} · {{s.refundOut ? '按到账日抵减' : '计入入账'}}</text><text>切换 ›</text>
    </view>
  </view>

  <view class="home-card networth-card" wx:if="{{accountCount > 0}}" bindtap="goFeature" data-url="/pages/accounts/accounts">
    <view class="section-heading"><text class="section-title">账户净资产</text><text class="section-link">查看账户 ›</text></view>
    <view class="networth-value"><text class="networth-currency">¥</text>{{netWorthText}}</view>
    <text class="secondary">{{accountCount}} 个账户 · 按期初余额与关联流水计算</text>
  </view>

  <view class="home-scope" wx:if="{{sharedJoined}}">
    <text class="scope-title">账本视角</text>
    <view class="scope-options">
      <view hover-class="scope-tap" class="scope-choice {{scope === 'mine' ? 'selected' : ''}}" data-k="mine" bindtap="setScope">自己</view>
      <view hover-class="scope-tap" class="scope-choice {{scope === 'both' ? 'selected' : ''}}" data-k="both" bindtap="setScope">全部成员</view>
      <view hover-class="scope-tap" class="scope-choice {{scope === 'peer' ? 'selected' : ''}}" data-k="peer" bindtap="setScope">其他成员</view>
    </view>
  </view>

  <view class="quick-card">
  <view class="quick-grid">
    <button class="quick-action" hover-class="none" bindtap="goAdd"><view class="quick-icon q-add">✍️</view><text class="quick-name">记一笔</text><text class="quick-note">随手记录</text></button>
    <button class="quick-action" hover-class="none" bindtap="goShot"><view class="quick-icon q-shot">📷</view><text class="quick-name">截图识别</text><text class="quick-note">从图片记账</text></button>
    <button class="quick-action" hover-class="none" bindtap="goImport"><view class="quick-icon q-imp">📥</view><text class="quick-name">账单导入</text><text class="quick-note">三类账单</text></button>
    <button class="quick-action" hover-class="none" bindtap="goReport"><view class="quick-icon q-rep">📊</view><text class="quick-name">看报表</text><text class="quick-note">了解钱的去向</text></button>
  </view>

  <view class="feature-grid">
    <button class="feature-action" hover-class="none" bindtap="goFeature" data-url="/pages/accounts/accounts"><text class="feature-mark">账</text><text class="feature-name">账户余额</text></button>
    <button class="feature-action" hover-class="none" bindtap="goFeature" data-url="/pages/recurring/recurring"><text class="feature-mark">循</text><text class="feature-name">周期账单</text></button>
    <button class="feature-action" hover-class="none" bindtap="goFeature" data-url="/pages/rules/rules"><text class="feature-mark">规</text><text class="feature-name">分类规则</text></button>
    <button class="feature-action" hover-class="none" bindtap="goFeature" data-url="/pages/health/health"><text class="feature-mark">检</text><text class="feature-name">数据体检</text></button>
  </view>
  </view>

  <view class="reminder-banner" wx:if="{{reminderCount > 0}}" bindtap="goFeature" data-url="/pages/recurring/recurring">
    <text class="reminder-title">{{reminderCount}} 笔周期账单近期到期</text>
    <text class="reminder-text">{{reminderText}}</text>
    <text class="section-link">去处理 ›</text>
  </view>

  <view class="reminder-banner rate-alert-banner" wx:if="{{rateAlertCount > 0}}" bindtap="goRateAlerts">
    <text class="reminder-title">{{rateAlertCount}} 个外币账户触发汇率提醒</text>
    <text class="reminder-text">{{rateAlertText}}</text>
    <text class="section-link">去确认 ›</text>
  </view>

  <view class="home-card insight-card" bindtap="goFeature" data-url="/pages/insights/insights">
    <view class="section-heading"><text class="section-title">月度财务健康</text><text class="section-link">查看报告 ›</text></view>
    <text class="secondary">从储蓄率、预算、分类集中度和数据体检看本月财务状态。</text>
  </view>

  <view class="home-card insight-card" bindtap="goFeature" data-url="/pages/annual/annual">
    <view class="section-heading"><text class="section-title">年度财务报告</text><text class="section-link">查看全年 ›</text></view>
    <text class="secondary">汇总 12 个月收支、分类排行、预算使用与年度健康趋势。</text>
  </view>

  <view class="home-card" wx:if="{{isVip}}" bindtap="goBudget">
    <view class="section-heading"><text class="section-title">月度预算</text><text class="section-link">{{budget > 0 ? '管理' : '去设置'}} ›</text></view>
    <block wx:if="{{budget > 0}}">
      <view class="budget-numbers"><text>已用 <text class="budget-value">¥{{budgetSpentText}}</text></text><text class="secondary">/ ¥{{budgetText}}</text></view>
      <view class="budget-track"><view class="budget-fill {{budgetOver ? 'over' : ''}}" style="width:{{budgetPct}}%"></view></view>
      <view class="budget-caption"><text class="{{budgetOver ? 'warning' : ''}}">{{budgetOver ? '超出' : '剩余'}} ¥{{budgetLeftText}}</text><text>{{scopeLabel || '全部账目'}} · 已扣当月退款</text></view>
    </block>
    <text wx:else class="secondary budget-empty">给日常开销定个范围，花钱更有数。</text>
  </view>

  <view class="uncat-notice" wx:if="{{uncatCount > 0}}" bindtap="goUncat"><view class="notice-dot"></view><text>{{uncatCount}} 笔本人记录待分类</text><text class="section-link">去整理 ›</text></view>

  <view class="home-card" wx:if="{{cats.length > 0}}">
    <view class="section-heading"><text class="section-title">{{s.refundOut ? '净支出去向' : '支出去向'}}</text><text class="section-link" bindtap="goReport">完整分析 ›</text></view>
    <view class="category-row" wx:for="{{cats}}" wx:key="name" data-name="{{item.name}}" bindtap="goCategory">
      <view class="category-label"><view class="category-dot" style="background:{{item.color}}"></view><text>{{item.name}}</text></view>
      <view class="category-meter"><view class="category-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
      <text class="category-amount">¥{{item.amountText}}</text>
    </view>
  </view>

  <view class="home-card recent-card">
    <view class="section-heading"><text class="section-title">最近流水</text><text class="section-link" bindtap="goList">当月全部 ›</text></view>
    <view class="home-empty" wx:if="{{!hasData}}">
      <view class="empty-mark"><view class="ui-icon icon-book"></view></view>
      <text class="empty-title">{{isCurrent ? '从这一笔开始' : '这个月还没有记录'}}</text>
      <text class="empty-note">{{isCurrent ? '认真生活，也把每一笔小事记下。' : '可以导入历史账单，或切换月份查看。'}}</text>
      <button class="empty-action" bindtap="goAdd">记一笔</button>
    </view>
    <text class="refund-empty" wx:elif="{{recent.length === 0}}">本月仅有退款抵减，已计入汇总；当月流水可查看每日抵减额。</text>
    <view class="recent-row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecent">
      <view class="category-initial" style="color:{{item.color}}">{{item.initial}}</view>
      <view class="recent-copy"><text class="recent-merchant">{{item.merchant}}</text><text class="recent-meta">{{item.category}} · {{item.timeText}}{{item.byLabel ? ' · ' + item.byLabel : ''}}</text></view>
      <text class="recent-amount {{item.type === 'income' || item.type === 'refund' ? 'income' : ''}}">{{item.sign}}¥{{item.amountText}}</text>
    </view>
  </view>

  <view class="shared-strip" wx:if="{{sharedJoined}}">
    <view class="shared-copy" bindtap="goShare"><text class="shared-title">{{sharedName}}</text><text class="shared-status">{{sharedStatus || '已加入共同账本'}} · 管理 / 邀请 ›</text></view>
    <button class="sync-button" catchtap="doSync" disabled="{{sharedSyncing}}" loading="{{sharedSyncing}}">{{sharedScopeRequired ? '确认范围' : '同步'}}</button>
  </view>
  <text class="home-footer">账目先存本机 · 备份与设置在「我的」</text>
</view>
