.home-page {
  --surface: #ffffff;
  --surface-soft: #edf3f0;
  --text: #253b34;
  --secondary: #7a8882;
  --line: #e8eeeb;
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
  padding: 28rpx 30rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f6f5;
  color: var(--text);
}
.home-page button { margin: 0; padding: 0; line-height: 1.4; font-size: 26rpx; border-radius: 0; font-weight: 500; border: 0; background: transparent; }
.home-page button::after { border: none; }
.home-heading { display: flex; justify-content: space-between; align-items: center; margin: 8rpx 4rpx 30rpx; gap: 24rpx; }
.heading-copy { min-width: 0; }
.eyebrow { display: block; color: var(--secondary); font-size: 23rpx; letter-spacing: 2rpx; margin-bottom: 8rpx; }
.greeting { display: block; font-size: 40rpx; line-height: 1.4; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.home-page .profile-button { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; flex: none; border: 1rpx solid var(--line); border-radius: 50%; color: var(--brand); background: var(--surface); }
.profile-image { width: 100%; height: 100%; border-radius: 50%; }
.balance-card { background: var(--hero-bg); border-radius: 32rpx; padding: 26rpx 30rpx 28rpx; color: #ffffff; }
.balance-top { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
/* 月份靠左；min-width:0 让这段在窄屏下能被压缩，不会把整张卡撑出屏幕 */
  .month-picker { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; }
.month-arrow { color: #ffffff; width: 64rpx; height: 72rpx; line-height: 72rpx; text-align: center; font-size: 34rpx; background: transparent; border: 0; flex: none; }
.home-page .month-arrow.off { opacity: .28; }
.arrow-tap { opacity: .5; }
.month-value { display: flex; align-items: center; font-size: 26rpx; padding: 10rpx 10rpx; white-space: nowrap; }
.picker-caret { font-size: 22rpx; opacity: .7; }
.month-badge, .home-page .current-button { flex: none; font-size: 21rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 10rpx; padding: 6rpx 12rpx; color: #ffffff; background: transparent; white-space: nowrap; }
.balance-label { display: block; font-size: 25rpx; margin: 24rpx 0 12rpx; opacity: .78; }
.balance-value { max-width: 100%; font-size: 70rpx; font-weight: 600; line-height: 1.3; letter-spacing: -2rpx; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.currency { font-size: 36rpx; margin-right: 10rpx; font-weight: 400; letter-spacing: 0; }
.balance-grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 32rpx; padding-top: 25rpx; border-top: 1rpx solid rgba(255,255,255,.18); }
.balance-metric { flex: 1.3; min-width: 0; }
.count-metric { flex: .65; text-align: right; }
.metric-label { display: block; font-size: 22rpx; opacity: .7; margin-bottom: 8rpx; }
.metric-number { display: block; font-size: 30rpx; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.unit { font-size: 21rpx; opacity: .7; }
.refund-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16rpx; margin-top: 26rpx; font-size: 21rpx; line-height: 1.5; color: rgba(255,255,255,.82); }
.refund-line > text:last-child { white-space: nowrap; }
.home-scope { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-top: 22rpx; gap: 12rpx; }
.scope-title { flex: none; white-space: nowrap; font-size: 23rpx; color: var(--secondary); }
.scope-options { display: flex; flex: 0 1 auto; min-width: 0; background: var(--surface-soft); border-radius: 14rpx; padding: 5rpx; }
.scope-choice { box-sizing: border-box; flex: 0 0 auto; min-width: 116rpx; min-height: 64rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; text-align: center; background: transparent; color: var(--secondary); font-size: 22rpx; line-height: 1.4; padding: 0 20rpx; border-radius: 10rpx; transition: background .12s ease, color .12s ease; }
.scope-choice.selected { background: var(--surface); color: var(--brand-ink); }
  /* 按下的即时反馈：小程序里 view 的 :active 不生效，只能用 hover-class */
  .scope-tap { background: var(--surface); color: var(--brand-ink); }
/* 四个快捷入口：不带独立描边，靠图标底色和留白分格，比四张贴纸干净 */
/* 快捷入口：整块一张白卡包住四个入口，图标用彩色方块（11-22 那版的样子） */
.quick-grid { width: 100%; max-width: 100%; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 4rpx; margin: 30rpx 0; padding: 26rpx 6rpx; background: var(--surface); border-radius: 26rpx; border: 1rpx solid var(--line); box-sizing: border-box; }
.quick-action { box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; overflow: hidden; background: transparent; color: var(--text); display: flex; flex-direction: column; align-items: center; padding: 6rpx 0; border-radius: 20rpx; }
.home-page .quick-action:active { background: var(--surface-soft); }
.quick-icon { flex: none; width: 78rpx; height: 78rpx; line-height: 78rpx; text-align: center; font-size: 34rpx; border-radius: 22rpx; margin-bottom: 12rpx; overflow: hidden; }
  /* 用半透明底：浅色下是淡彩、深色下自动沉下去，不用再单独写一套深色 */
  /* 四格图标统一品牌色系：只保留「记一笔」一个强调色，其余沉到中性底，避免橙蓝紫抢主题 */
  .q-add { background: rgba(23,128,107,.14); }
  .q-shot, .q-imp, .q-rep { background: var(--surface-soft); }
.quick-name { display: block; width: 100%; max-width: 100%; font-size: 25rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quick-note { display: block; width: 100%; max-width: 100%; margin-top: 5rpx; font-size: 19rpx; color: var(--secondary); font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.feature-grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8rpx; margin: 8rpx 0 0; padding: 20rpx 4rpx 2rpx; border-top: 1rpx dashed var(--line); }
.feature-action { display: flex; flex-direction: column; align-items: center; gap: 8rpx; min-width: 0; padding: 8rpx 2rpx; border-radius: 16rpx; background: transparent; color: var(--text); font-size: 21rpx; }
.feature-name { max-width: 100%; font-size: 20rpx; color: var(--secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.feature-mark { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 14rpx; background: rgba(23,128,107,0.08); color: var(--brand); font-size: 23rpx; font-weight: 600; }
.networth-value { margin: 4rpx 0 10rpx; font-size: 46rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.networth-currency { margin-right: 6rpx; font-size: 28rpx; color: var(--secondary); }
.reminder-banner { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 18rpx; margin: -8rpx 0 22rpx; padding: 22rpx 24rpx; border: 1rpx solid #ead7b7; border-radius: 20rpx; background: #fbf4e8; color: #6f532b; }
.reminder-title { flex: 1; font-size: 25rpx; font-weight: 600; }
.reminder-text { flex-basis: 100%; font-size: 21rpx; color: #8a6a3d; }
.insight-card { border-color: var(--brand-line, #cfe0da); }
.dark .reminder-banner { background: #3b3426; border-color: #5a4b33; color: #e0c58f; }
.dark .reminder-text { color: #c9ae7d; }
.rate-alert-banner { background: #edf4f8; border-color: #cddfe8; color: #31576b; }
.rate-alert-banner .reminder-text { color: #53748a; }
.dark .rate-alert-banner { background: #25333b; border-color: #38515f; color: #b8d6e5; }
.dark .rate-alert-banner .reminder-text { color: #9cb9c9; }
.home-card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 26rpx; padding: 28rpx; margin-top: 22rpx; }
/* 净资产卡：跟普通白卡区分开，用淡品牌底 + 细边，数字才是主角 */
.networth-card { background: var(--brand-soft, #eef6f3); border-color: var(--brand-line, #cfe0da); }
.dark .networth-card { background: #22302a; border-color: #33503f; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 22rpx; }
.section-title { font-size: 29rpx; font-weight: 600; }
.section-link { font-size: 23rpx; color: var(--brand); white-space: nowrap; }
.secondary { color: var(--secondary); font-size: 23rpx; }
.budget-numbers { display: flex; align-items: baseline; gap: 10rpx; font-size: 24rpx; }
.budget-value { font-size: 31rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.budget-track { height: 10rpx; background: var(--surface-soft); margin: 22rpx 0 14rpx; border-radius: 6rpx; overflow: hidden; }
.budget-fill { height: 100%; background: var(--brand); border-radius: 6rpx; }
.budget-fill.over { background: #c56a51; }
.budget-caption { display: flex; justify-content: space-between; gap: 12rpx; font-size: 21rpx; color: var(--secondary); }
.warning { color: #ba624b; }
.budget-empty { display: block; line-height: 1.7; }
.uncat-notice { display: flex; gap: 14rpx; align-items: center; padding: 22rpx 4rpx 0; font-size: 24rpx; }
.uncat-notice > text:first-of-type { flex: 1; }
.notice-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #b48947; }
.category-row { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 0; }
.category-label { width: 172rpx; display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; flex: none; }
.category-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex: none; }
.category-meter { flex: 1; height: 8rpx; background: var(--surface-soft); border-radius: 4rpx; overflow: hidden; }
.category-fill { height: 100%; border-radius: 4rpx; }
.category-amount { font-variant-numeric: tabular-nums; font-size: 24rpx; text-align: right; min-width: 128rpx; }
.recent-card { padding-bottom: 8rpx; }
.recent-row { display: flex; align-items: center; gap: 18rpx; border-top: 1rpx solid var(--line); padding: 25rpx 0; }
.category-initial { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: var(--surface-soft); border-radius: 18rpx; font-size: 30rpx; flex: none; }
.recent-copy { flex: 1; min-width: 0; }
.recent-merchant { display: block; font-size: 27rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recent-meta { display: block; font-size: 20rpx; color: var(--secondary); line-height: 1.5; margin-top: 7rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recent-amount { font-size: 29rpx; font-weight: 500; font-variant-numeric: tabular-nums; flex: none; }
.recent-amount.income { color: var(--brand); }
.home-empty { display: flex; flex-direction: column; align-items: center; padding: 28rpx 4rpx 32rpx; }
.empty-mark { width: 100rpx; height: 100rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; color: var(--brand); background: var(--surface-soft); margin-bottom: 24rpx; }
.empty-title { font-size: 28rpx; font-weight: 500; }
.empty-note { font-size: 23rpx; color: var(--secondary); margin: 12rpx 0 24rpx; line-height: 1.7; text-align: center; }
.home-page .empty-action { border-radius: 16rpx; background: var(--brand); color: #ffffff; padding: 18rpx 54rpx; }
.refund-empty { display: block; color: var(--secondary); font-size: 24rpx; line-height: 1.8; padding: 12rpx 0 30rpx; }
.shared-strip { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 4rpx 0; }
.shared-copy { min-width: 0; flex: 1; }
.shared-title { display: block; font-size: 24rpx; font-weight: 500; }
.shared-status { display: block; margin-top: 8rpx; font-size: 20rpx; line-height: 1.6; color: var(--secondary); overflow-wrap: anywhere; }
.home-page .sync-button { color: var(--brand); background: var(--surface); border: 1rpx solid var(--line); padding: 14rpx 22rpx; border-radius: 14rpx; font-size: 23rpx; flex: none; }
.home-footer { display: block; text-align: center; color: var(--secondary); font-size: 21rpx; margin-top: 36rpx; }
.home-page.dark { --surface: #1b2421; --surface-soft: #24332c; --text: #e5eee9; --secondary: #a0b0a7; --line: #2c3831; background: #111916; --brand-ink: #a6d6c4; }
.dark .balance-card { background: var(--hero-bg-dark); }
.dark .scope-choice.selected, .dark .section-link, .dark .sync-button, .dark .recent-amount.income { color: #94cbb7; }
@media (min-width: 600px) {
  .home-page { padding-left: 8vw; padding-right: 8vw; }
}
