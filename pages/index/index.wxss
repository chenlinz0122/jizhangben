page { background: #f4f6f5; }

.mine-page {
  --mine-bg: #f4f6f5;
  --mine-card: #ffffff;
  --mine-line: #e6ece8;
  --mine-text: #24352e;
  --mine-muted: #738078;
  --mine-soft: #f0f4f2;
  --mine-accent: var(--brand, #17806b);
  --mine-tint: var(--brand-soft, #e7f5ef);
  --mine-accent-text: var(--brand-ink, #0f5f50);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  color: var(--mine-text);
  background: var(--mine-bg);
}

.mine-heading { padding: 4rpx 8rpx 26rpx; }
.mine-title { display: block; font-size: 40rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1.4; }
.mine-subtitle { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--mine-muted); }
.mine-card { border: 1rpx solid var(--mine-line); border-radius: 24rpx; background: var(--mine-card); overflow: hidden; }
.mine-button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--mine-text); font-size: 28rpx; font-weight: 400; text-align: left; line-height: 1.5; }
.mine-button::after { border: 0; }
.mine-button.is-off { color: var(--mine-muted); background: transparent; opacity: 0.55; }
.mine-pressed { opacity: 0.7; }
.row-copy { flex: 1; min-width: 0; }
.row-title { display: block; font-size: 28rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.row-note { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.6; color: var(--mine-muted); }
.mine-page .icon-chevron { flex: none; margin-left: 16rpx; color: var(--mine-muted); }

.profile-row { display: flex; align-items: center; width: 100%; box-sizing: border-box; padding: 32rpx 28rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin-right: 24rpx; border-radius: 32rpx; background: var(--mine-tint); color: var(--mine-accent-text); font-size: 42rpx; font-weight: 500; overflow: hidden; flex: none; }
.avatar-image { width: 100%; height: 100%; }
.profile-name { display: block; font-size: 34rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.local-summary { display: flex; align-items: center; padding: 26rpx 0 30rpx; margin: 0 28rpx; border-top: 1rpx solid var(--mine-line); }
.record-summary { flex: 0 0 35%; padding-right: 16rpx; box-sizing: border-box; }
.summary-label { display: block; font-size: 22rpx; line-height: 1.5; color: var(--mine-muted); }
.record-count { display: inline-block; margin-top: 6rpx; font-size: 44rpx; font-weight: 600; line-height: 1.3; word-break: break-all; }
.record-unit { font-size: 22rpx; color: var(--mine-muted); }
.backup-summary { flex: 1; min-width: 0; padding-left: 24rpx; border-left: 1rpx solid var(--mine-line); }
.backup-time { display: block; margin-top: 8rpx; font-size: 23rpx; font-weight: 500; line-height: 1.5; }
.summary-note { display: block; margin-top: 6rpx; font-size: 20rpx; color: var(--mine-muted); line-height: 1.5; }

.membership-strip { display: flex; align-items: center; width: 100%; box-sizing: border-box; margin-top: 20rpx; padding: 24rpx 28rpx; border: 1rpx solid var(--mine-line); border-radius: 24rpx; background: var(--mine-tint); color: var(--mine-accent-text); }
.membership-title { display: block; font-size: 27rpx; font-weight: 600; }
.membership-status { display: block; font-size: 21rpx; margin-top: 6rpx; line-height: 1.6; }
.membership-action { flex: none; margin-left: 18rpx; font-size: 23rpx; font-weight: 500; }
.section-heading { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 8rpx 16rpx; font-size: 25rpx; font-weight: 600; }
.section-note { font-size: 21rpx; font-weight: 400; color: var(--mine-muted); }
.icon-tile { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; margin-right: 20rpx; background: var(--mine-tint); color: var(--mine-accent-text); flex: none; }
.tile-neutral { background: var(--mine-soft); color: var(--mine-muted); }
.shared-card { padding: 26rpx 28rpx 0; }
.shared-top { display: flex; align-items: center; }
.shared-details { margin-top: 22rpx; }
.member-names { display: block; color: var(--mine-muted); font-size: 23rpx; line-height: 1.6; margin-bottom: 16rpx; overflow-wrap: break-word; }
.detail-line { display: flex; align-items: flex-start; margin-top: 12rpx; font-size: 22rpx; line-height: 1.65; }
.detail-label { flex: none; color: var(--mine-muted); margin-right: 24rpx; }
.detail-value { flex: 1; min-width: 0; text-align: right; }
.scope-warning { padding: 18rpx 20rpx; margin-top: 20rpx; background: #f8f3e9; color: #846329; border-radius: 16rpx; font-size: 22rpx; line-height: 1.7; }
.shared-hint { display: block; margin-top: 18rpx; color: var(--mine-muted); font-size: 20rpx; line-height: 1.65; }
.shared-intro { display: block; margin-top: 20rpx; font-size: 23rpx; color: var(--mine-muted); line-height: 1.75; }
.shared-manage { display: flex; justify-content: space-between; align-items: center; width: 100%; box-sizing: border-box; min-height: 88rpx; border-top: 1rpx solid var(--mine-line); margin-top: 22rpx; color: var(--mine-accent-text); font-size: 25rpx; font-weight: 500; }
.menu-card { padding: 0 28rpx; }
.menu-row { display: flex; align-items: center; width: 100%; box-sizing: border-box; min-height: 124rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--mine-line); }
.menu-row:last-child { border-bottom: 0; }

.fold-row { display: flex; align-items: center; width: 100%; box-sizing: border-box; min-height: 124rpx; padding: 24rpx 0; }
.fold-state { flex: none; margin-left: auto; font-size: 22rpx; color: var(--mine-muted); }
.fold-chevron { transition: transform 0.18s ease; }
.fold-chevron.is-open { transform: rotate(-90deg); }
.tool-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 4rpx 0 20rpx; }
.tool-cell { display: flex; flex-direction: column; align-items: flex-start; width: calc(50% - 8rpx); box-sizing: border-box; margin: 0 0 16rpx; padding: 22rpx 20rpx; border: 1rpx solid var(--mine-line); border-radius: 20rpx; background: var(--mine-card); color: var(--mine-text); font-size: 28rpx; font-weight: 400; line-height: 1.4; text-align: left; }
.tool-cell::after { border: 0; }
.tool-cell.is-off { opacity: 0.55; }
.tool-cell .tile-sm { width: 56rpx; height: 56rpx; border-radius: 16rpx; margin: 0 0 12rpx; }
.tool-title { display: block; max-width: 100%; font-size: 26rpx; font-weight: 500; }
.tool-note { display: block; max-width: 100%; margin-top: 4rpx; font-size: 21rpx; line-height: 1.4; color: var(--mine-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.busy-note { display: block; margin: 18rpx 8rpx 0; font-size: 22rpx; color: var(--mine-muted); line-height: 1.6; }

.theme-heading { display: flex; align-items: center; padding: 26rpx 0 22rpx; }
.theme-options { display: flex; gap: 14rpx; padding-bottom: 26rpx; }
.theme-option { flex: 1; min-width: 0; display: flex; align-items: center; flex-direction: column; padding: 20rpx 8rpx 16rpx; border: 2rpx solid var(--mine-line); border-radius: 20rpx; background: var(--mine-card); }
.theme-option.is-selected { border-color: var(--mine-accent); background: var(--mine-tint); }
.theme-dot { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 50%; }
.dot-green { background: #17806b; }
.dot-ink { background: #2f5d8a; }
.dot-amber { background: #b96a2b; }
.theme-check { width: 10rpx; height: 18rpx; margin-top: -5rpx; border-right: 3rpx solid #fff; border-bottom: 3rpx solid #fff; transform: rotate(45deg); }
.theme-name { margin-top: 10rpx; font-size: 24rpx; font-weight: 500; }
.theme-state { margin-top: 3rpx; color: var(--mine-muted); font-size: 20rpx; }
.is-selected .theme-state { color: var(--mine-accent-text); }
.refund-row { display: flex; align-items: center; padding: 24rpx 0; border-top: 1rpx solid var(--mine-line); }
.refund-row switch { flex: none; margin-left: 12rpx; transform: scale(0.82); transform-origin: right center; }
.logout-button { margin-top: 28rpx; padding: 25rpx 16rpx; text-align: center; border: 1rpx solid var(--mine-line); border-radius: 24rpx; background: var(--mine-card); font-size: 25rpx; color: var(--mine-muted); }
.mine-footer { padding: 38rpx 12rpx 8rpx; text-align: center; color: var(--mine-muted); font-size: 22rpx; line-height: 1.8; letter-spacing: 1rpx; }
.mine-footer text { display: block; font-size: 20rpx; letter-spacing: 0; }

.mine-page.dark {
  --mine-bg: #141b18;
  --mine-card: #1e2823;
  --mine-line: #34423a;
  --mine-text: #e2eae5;
  --mine-muted: #a7b5ad;
  --mine-soft: #2a3630;
  --mine-tint: #243f34;
  --mine-accent: #81c7a9;
  --mine-accent-text: #a1dbbe;
}
.mine-page.dark.theme-ink { --mine-tint: #263949; --mine-accent: #94bddf; --mine-accent-text: #b1d1ec; }
.mine-page.dark.theme-amber { --mine-tint: #443529; --mine-accent: #e0b389; --mine-accent-text: #efc79f; }
.dark .scope-warning { background: #3b3426; color: #e0c58f; }
