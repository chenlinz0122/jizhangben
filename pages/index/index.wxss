.wrap {
  min-height: 100vh;
  background: #f4f5f7;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(160deg, #1a8f76 0%, #12695a 100%);
  color: #ffffff;
  padding: 0 40rpx 52rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 105, 90, 0.22);
}

.statusbar {
  height: 96rpx;
}

.month {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 8rpx 0 28rpx;
}

.nav {
  font-size: 44rpx;
  width: 56rpx;
  text-align: center;
  opacity: 0.85;
}

.nav.off {
  opacity: 0.25;
}

.mtext {
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.cap {
  font-size: 24rpx;
  opacity: 0.75;
}

.big {
  font-size: 76rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.2;
  margin-top: 6rpx;
}

.cny {
  font-size: 36rpx;
  font-weight: 500;
  margin-right: 6rpx;
  opacity: 0.85;
}

.meta {
  display: flex;
  margin-top: 28rpx;
  gap: 24rpx;
}

.metai {
  flex: 1;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.meT {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
}

.meN {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.notice {
  margin: 24rpx 24rpx 0;
  background: #f3ece0;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #9a7a4a;
  font-size: 26rpx;
}

.nc-arrow {
  font-size: 32rpx;
}

.guide {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.gtitle {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.gstep {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  color: #5a6169;
  font-size: 26rpx;
  line-height: 1.5;
}

.gn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #e3f0ec;
  color: #17806b;
  font-size: 22rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 16rpx;
  flex: none;
}

.gbtn {
  margin-top: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
}

.cat {
  margin-bottom: 24rpx;
}

.cname {
  font-size: 26rpx;
  color: #33383e;
}

.camt {
  font-size: 24rpx;
  color: #8b9198;
}

.track {
  height: 12rpx;
  background: #efF1f3;
  border-radius: 8rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.fill {
  height: 12rpx;
  border-radius: 8rpx;
  min-width: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.item:last-child {
  border-bottom: none;
}

.ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-em {
  font-size: 30rpx;
  line-height: 1;
}

.ileft {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.im {
  display: block;
  font-size: 28rpx;
  color: #1c1f23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.isub {
  display: block;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.iamt {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(244, 245, 247, 0.96);
}

.actions .btn {
  flex: 1;
}
