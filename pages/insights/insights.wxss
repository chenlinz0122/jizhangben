.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #f4f6f5;
  color: #1c1f23;
  --ring-track: #e4ebe7;
}

.hero {
  padding: calc(24rpx + env(safe-area-inset-top)) 32rpx 58rpx;
  color: #ffffff;
  background: var(--hero-bg, linear-gradient(160deg, #1a8f76 0%, #12695a 100%));
  box-shadow: var(--hero-shadow, 0 16rpx 36rpx rgba(18, 105, 90, 0.2));
}

.hero-top, .month-bar, .metric-line, .breakdown-head, .net-worth {
  display: flex;
  align-items: center;
}

.hero-top { justify-content: space-between; gap: 20rpx; }
.back { flex: none; padding: 10rpx 4rpx; font-size: 24rpx; }
.scope { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; color: rgba(255, 255, 255, 0.76); }
.hero-title { margin-top: 22rpx; font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { margin-top: 10rpx; font-size: 23rpx; line-height: 1.6; color: rgba(255, 255, 255, 0.78); }

.month-bar {
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.12);
}
.month-arrow { width: 72rpx; padding: 12rpx 0; text-align: center; font-size: 38rpx; line-height: 1; }
.month-arrow.off { opacity: 0.3; }
.month-picker { padding: 10rpx 38rpx; font-size: 28rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.month-caret { margin-left: 12rpx; font-size: 22rpx; opacity: 0.8; }
.current-month { margin-top: 14rpx; padding: 6rpx 0; text-align: center; font-size: 21rpx; color: rgba(255, 255, 255, 0.72); }
.current-month.on { visibility: hidden; }

.card { margin: 24rpx; padding: 30rpx; border: 1rpx solid #e3e9e6; border-radius: 26rpx; background: #ffffff; }
.loading { color: #7a8882; text-align: center; font-size: 26rpx; }
.empty { padding: 54rpx 30rpx; text-align: center; }
.empty-title { color: #2b3339; font-size: 30rpx; font-weight: 600; }
.empty-desc { margin-top: 14rpx; color: #7b8882; font-size: 24rpx; line-height: 1.75; }
.primary-action { display: inline-block; min-width: 220rpx; margin-top: 26rpx; padding: 20rpx 30rpx; border-radius: 16rpx; color: #ffffff; background: var(--brand, #17806b); font-size: 26rpx; text-align: center; }

.score-card { display: flex; align-items: center; gap: 34rpx; margin-top: -34rpx; position: relative; box-shadow: 0 12rpx 32rpx rgba(31, 56, 46, 0.08); }
.score-ring { flex: none; width: 184rpx; height: 184rpx; padding: 16rpx; border-radius: 50%; box-sizing: border-box; }
.score-center { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #ffffff; }
.score-number { color: var(--brand-ink, #0f5f50); font-size: 58rpx; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
.score-total { margin-top: 4rpx; color: #8b9691; font-size: 20rpx; }
.score-copy { flex: 1; min-width: 0; }
.score-label { display: block; color: #25332d; font-size: 30rpx; font-weight: 700; }
.score-desc { display: block; margin-top: 12rpx; color: #78867f; font-size: 23rpx; line-height: 1.65; }
.score-count { display: block; margin-top: 12rpx; color: var(--brand, #17806b); font-size: 22rpx; }

.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 32rpx 14rpx; }
.section-title { color: #25332d; font-size: 29rpx; font-weight: 700; }
.section-note { color: #96a19c; font-size: 20rpx; }

.metrics { padding: 8rpx 30rpx; }
.metric-grid { display: flex; flex-wrap: wrap; }
.metric { width: 50%; box-sizing: border-box; padding: 24rpx 0; }
.metric:nth-child(odd) { padding-right: 22rpx; border-right: 1rpx solid #edf1ef; }
.metric:nth-child(even) { padding-left: 26rpx; }
.metric:nth-child(-n+2) { border-bottom: 1rpx solid #edf1ef; }
.metric-label { display: block; color: #7b8882; font-size: 22rpx; }
.metric-value { display: block; margin-top: 8rpx; color: #293730; font-size: 32rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.metric-hint { display: block; margin-top: 5rpx; color: #a0aaa5; font-size: 19rpx; }
.positive { color: #1f7a4d !important; }
.negative { color: #c14640 !important; }
.good { color: #1f7a4d !important; }
.warning { color: #a86b24 !important; }
.metric-line { justify-content: space-between; gap: 24rpx; padding: 22rpx 0; border-top: 1rpx solid #edf1ef; }
.metric-line-label { flex: none; color: #7b8882; font-size: 23rpx; }
.metric-line-value { color: #33413b; font-size: 23rpx; text-align: right; font-variant-numeric: tabular-nums; }

.net-worth { justify-content: space-between; gap: 24rpx; background: var(--brand-soft, #e7f5ef); border-color: var(--brand-line, #cfe0da); }
.net-worth-label { display: block; color: var(--brand-ink, #0f5f50); font-size: 25rpx; font-weight: 600; }
.net-worth-hint { display: block; margin-top: 8rpx; color: #70847a; font-size: 20rpx; }
.net-worth-value { flex: none; color: var(--brand-ink, #0f5f50); font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; }

.breakdown { padding: 6rpx 30rpx; }
.breakdown-item { padding: 25rpx 0; border-bottom: 1rpx solid #edf1ef; }
.breakdown-item:last-child { border-bottom: 0; }
.breakdown-head { justify-content: space-between; }
.breakdown-label { color: #33413b; font-size: 26rpx; font-weight: 600; }
.breakdown-score { color: var(--brand-ink, #0f5f50); font-size: 27rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.breakdown-max { color: #96a19c; font-size: 20rpx; font-weight: 400; }
.progress-track { height: 10rpx; margin-top: 15rpx; overflow: hidden; border-radius: 999rpx; background: #edf2ef; }
.progress-fill { height: 100%; border-radius: inherit; background: var(--brand, #17806b); }
.breakdown-value { display: block; margin-top: 13rpx; color: #4f5f57; font-size: 23rpx; font-variant-numeric: tabular-nums; }
.breakdown-hint { display: block; margin-top: 7rpx; color: #8b9691; font-size: 21rpx; line-height: 1.6; }

.suggestions { padding: 8rpx 30rpx; }
.suggestion { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #edf1ef; }
.suggestion:last-child { border-bottom: 0; }
.suggestion-index { flex: none; width: 38rpx; height: 38rpx; border-radius: 50%; color: var(--brand-ink, #0f5f50); background: var(--brand-soft, #e7f5ef); font-size: 21rpx; line-height: 38rpx; text-align: center; }
.suggestion-text { flex: 1; color: #58675f; font-size: 24rpx; line-height: 1.7; }

.report-note { padding: 12rpx 40rpx 24rpx; color: #939e99; font-size: 21rpx; line-height: 1.8; text-align: center; }
.report-note text { display: block; }
.copy-button { margin: 0 24rpx; padding: 25rpx; border-radius: 18rpx; color: #ffffff; background: var(--brand, #17806b); font-size: 28rpx; font-weight: 600; text-align: center; }
.safe-bottom { height: env(safe-area-inset-bottom); }

.page.dark { color: #e5eee9; background: #111916; --ring-track: #33443b; }
.dark .hero { background: var(--hero-bg-dark, linear-gradient(160deg, #145247 0%, #0c3730 100%)); }
.dark .card { border-color: #2c3831; background: #1b2421; }
.dark .loading, .dark .empty-desc, .dark .metric-label, .dark .metric-line-label,
.dark .metric-hint, .dark .breakdown-hint, .dark .section-note, .dark .report-note { color: #a0b0a7; }
.dark .empty-title, .dark .score-label, .dark .section-title, .dark .metric-value,
.dark .metric-line-value, .dark .breakdown-label, .dark .breakdown-value { color: #e5eee9; }
.dark .score-center { background: #1b2421; }
.dark .score-number { color: #a8e0c9; }
.dark .score-total, .dark .breakdown-max { color: #a0b0a7; }
.dark .score-count { color: #a8e0c9; }
.dark .metric:nth-child(odd), .dark .metric:nth-child(-n+2), .dark .metric-line,
.dark .breakdown-item, .dark .suggestion { border-color: #2c3831; }
.dark .progress-track { background: #304139; }
.dark .net-worth { border-color: #345749; background: #172a23; }
.dark .net-worth-label, .dark .net-worth-value { color: #a8e0c9; }
.dark .net-worth-hint { color: #a0b0a7; }
.dark .suggestion-text { color: #bac8c1; }
.dark .suggestion-index { color: #a8e0c9; background: #294238; }
.dark .positive, .dark .good { color: #9bd8b7 !important; }
.dark .negative { color: #efb0a3 !important; }
.dark .warning { color: #e3c58f !important; }

@media (prefers-color-scheme: dark) {
  .page { background: #111916; color: #e5eee9; }
}
