<view class="theme-{{themeKey}} page">
  <view class="bar">
    <view class="search">
      <text class="sicon">🔍</text>
      <input class="sinput" value="{{kw}}" placeholder="搜商户 / 备注 / 分类" placeholder-class="sph"
             bindinput="onSearch" confirm-type="search" />
      <text class="sclear" wx:if="{{kw}}" bindtap="clearKw">×</text>
    </view>
    <view class="month">
      <text class="nav" bindtap="prevMonth" wx:if="{{!searching}}">‹</text>
      <text class="mtext">{{monthText}}</text>
      <text class="nav {{canNext ? '' : 'off'}}" bindtap="nextMonth" wx:if="{{!searching}}">›</text>
    </view>
    <view class="sumrow">
      <text class="sumi">支出 ¥{{s.expenseText}}</text>
      <text class="sumi">收入 ¥{{s.incomeText}}</text>
      <text class="sumi">{{s.count}} 笔</text>
    </view>
    <view class="chips">
      <text class="chip back" wx:if="{{backTab}}" bindtap="goBack">‹ 返回{{backLabel}}</text>
      <text class="chip on" wx:if="{{filterCat}}" bindtap="clearFilter">× {{filterCat}}</text>
      <text class="chip on" wx:if="{{filterDay}}" bindtap="clearFilter">× {{filterDay}}</text>
      <text class="chip {{onlyUncat ? 'on' : ''}}" bindtap="toggleUncat">只看未分类</text>
      <block wx:if="{{sharedOn}}">
        <text class="chip {{scope === 'all' ? 'on' : ''}}" data-k="all" bindtap="setScope">全部{{sharedMembers > 1 ? ' ·' + sharedMembers + '人' : ''}}</text>
        <text class="chip {{scope === 'mine' ? 'on' : ''}}" data-k="mine" bindtap="setScope">只看我</text>
      </block>
      <text class="chip" bindtap="goImport">＋ 导入</text>
      <text class="chip" bindtap="moreActions">⋯ 管理</text>
    </view>
  </view>

  <view class="empty" wx:if="{{groups.length === 0}}">
    <text>{{searching ? '没找到匹配的流水，换个关键词试试' : '这个月没有流水'}}</text>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="day" wx:for-item="g">
    <view class="ghead">
      <text class="gday">{{g.label}}</text>
      <text class="gspend">支出 ¥{{g.spendText}}</text>
    </view>
    <view class="items">
      <view class="item" wx:for="{{g.items}}" wx:key="id"
            data-id="{{item.id}}" bindtap="openSheet" bindlongpress="onLongPress">
        <view class="ic" style="background:{{item.tint}}"><text class="ic-em">{{item.icon}}</text></view>
        <view class="ileft">
          <view class="imrow">
            <text class="im">{{item.merchant}}</text>
            <text class="bytag" wx:if="{{item.byLabel}}">{{item.byLabel}} 标记的</text>
          </view>
          <text class="isub">{{item.category}} · {{item.timeText}}<text class="notedot" wx:if="{{item.note}}"> · 有备注</text></text>
          <text class="idesc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
        <text class="iamt {{item.type === 'income' || item.type === 'refund' ? 'inc' : (item.type === 'transfer' ? 'muted' : 'exp')}}">{{item.sign}}{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <view class="tip">点一笔看明细：时间、说明、来源、备注都在里面，顺手能改分类、加备注、删除；右上「⋯ 管理」能删整个月、清空全部</view>
</view>

<view class="mask" wx:if="{{sheetVisible}}" bindtap="closeSheet"></view>
<view class="sheet {{sheetVisible ? 'up' : ''}}">
  <!-- 明细头：金额 + 方向 -->
  <view class="shamt-row">
    <view class="shamt {{sheetItem.dirClass}}">
      <text class="shsign">{{sheetItem.sign}}</text><text class="shnum">{{sheetItem.amountText}}</text>
    </view>
    <text class="shdir {{sheetItem.dirClass}}">{{sheetItem.dirText}}</text>
    <text class="shclose" bindtap="closeSheet">关闭</text>
  </view>
  <view class="shmerchant">{{sheetItem.merchant}}</view>

  <!-- 明细字段 -->
  <view class="shcard">
    <view class="srow">
      <text class="sl">分类</text>
      <view class="sv-right">
        <text class="scatdot" style="background:{{sheetItem.color}}"></text>
        <text class="sv">{{sheetItem.icon}} {{sheetItem.category}}</text>
      </view>
    </view>
    <view class="srow">
      <text class="sl">时间</text>
      <text class="sv">{{sheetItem.dateText}} {{sheetItem.timeText}}</text>
    </view>
    <view class="srow" wx:if="{{sheetItem.byLabel}}" bindtap="editByRemark">
      <text class="sl">记账人</text>
      <text class="sv">{{sheetItem.byLabel}} 标记的<text class="sv-dim"> · 点这里改备注</text></text>
    </view>
    <view class="srow" wx:if="{{sheetItem.desc}}">
      <text class="sl">说明</text>
      <text class="sv sv-wrap">{{sheetItem.desc}}</text>
    </view>
    <view class="srow" wx:if="{{sheetItem.status}}">
      <text class="sl">状态</text>
      <text class="sv">{{sheetItem.status}}</text>
    </view>
    <view class="srow" wx:if="{{sheetItem.why}}">
      <text class="sl">分类依据</text>
      <text class="sv sv-wrap sv-dim">{{sheetItem.why}}</text>
    </view>
    <view class="srow">
      <text class="sl">来源</text>
      <text class="sv">{{sheetItem.source || '—'}}<text class="sv-dim" wx:if="{{sheetItem.account}}"> · {{sheetItem.account}}</text></text>
    </view>
    <view class="srow">
      <text class="sl">备注</text>
      <text class="sv {{sheetItem.note ? '' : 'sv-dim'}}" bindtap="editNote">{{sheetItem.note || '点这里添加'}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="shacts">
    <view class="act {{catMode ? 'on' : ''}}" bindtap="toggleCatMode">{{catMode ? '收起类目' : '改分类'}}</view>
    <view class="act" bindtap="editNote">改备注</view>
    <view class="act danger" bindtap="deleteSheetItem">删除</view>
  </view>

  <scroll-view scroll-y class="shlist" wx:if="{{catMode}}">
    <view class="shcat {{sheetItem.category === item ? 'on' : ''}}"
          wx:for="{{sheetCats}}" wx:key="*this" data-cat="{{item}}" bindtap="pickCat">
      <text>{{item}}</text>
      <text class="shcheck" wx:if="{{sheetItem.category === item}}">✓</text>
    </view>
  </scroll-view>
</view>
