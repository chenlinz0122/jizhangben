.page {
  min-height: 100vh;
  background: #f4f6f5;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bar {
  background: #ffffff;
  padding: 24rpx 32rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.month {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.nav {
  font-size: 40rpx;
  color: var(--brand, #17806b);
  width: 48rpx;
  text-align: center;
}

.nav.off {
  color: #cfd4d8;
}

.mtext {
  font-size: 30rpx;
  font-weight: 600;
}

.sumrow {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8b9198;
}

/* 退款被抵扣掉的那句说明 */
.refnote {
  display: block;
  text-align: center;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9aa0a6;
  opacity: 0.9;
}

.chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
}

.search {
  display: flex;
  align-items: center;
  background: #f4f5f7;
  border-radius: 28rpx;
  padding: 14rpx 24rpx;
  gap: 14rpx;
}

.sicon {
  font-size: 26rpx;
  color: #8b9198;
}

.sinput {
  flex: 1;
  font-size: 27rpx;
  color: #1c1f23;
}

.sph {
  color: #b1b7bd;
}

.sclear {
  font-size: 30rpx;
  color: #8b9198;
  padding: 0 8rpx;
}

.chip {
  font-size: 24rpx;
  color: #5a6169;
  background: #f2f3f5;
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
}

.chip.on {
  background: #e3f0ec;
  color: var(--brand, #17806b);
  font-weight: 500;
}

/* 返回按钮：跨 tab 跳转没有原生返回箭头，得自己给一个 */
.chip.back {
  background: var(--brand, #17806b);
  color: #ffffff;
  font-weight: 600;
}

.group {
  margin: 24rpx 24rpx 0;
}

.ghead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 12rpx;
}

.gday {
  font-size: 24rpx;
  color: #8b9198;
}

.gspend {
  font-size: 22rpx;
  color: #a2a8ae;
}

.items {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e6ece8;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.items .item:last-child {
  border-bottom: none;
}

.ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  margin-right: 20rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-em {
  font-size: 32rpx;
  line-height: 1;
}

.ileft {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

/* 商户名 +「谁记的」小标签并排 */
.imrow {
  display: flex;
  align-items: center;
}

.im {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bytag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #a9702d;
  background: #fbf1e3;
  border-radius: 999rpx;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.isub {
  display: block;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

/* 部分退款：告诉用户这笔原本多少、退了多少，现在显示的是净额 */
.irefund {
  display: block;
  font-size: 21rpx;
  color: #1f7a4d;
  margin-top: 4rpx;
}

/* 没配上付款的退款：整行留在这儿，颜色压下去，别让它看起来像一笔进账 */
.irefund.gray {
  color: #9aa0a6;
}

/* 行内的商品说明：账单里的「美团-机票」这种关键信息 */
.idesc {
  display: block;
  font-size: 22rpx;
  color: #b1b7bd;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notedot {
  color: #b89a6d;
}

.amount-block {
  flex: none;
  max-width: 42%;
  text-align: right;
}

.cny-equivalent,
.transfer-native {
  display: block;
  margin-top: 5rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #8b9490;
  word-break: break-all;
}

.cny-equivalent { color: #6f8c80; }

.iamt {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  align-self: flex-start;
  padding-top: 4rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #b1b7bd;
  padding: 32rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.22s ease-out;
  z-index: 101;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet.up {
  transform: translateY(0);
  max-height: 88vh;
  overflow-y: auto;
}

.shclose {
  font-size: 26rpx;
  color: #8b9198;
  padding-left: 20rpx;
  align-self: center;
}

/* ---------- 明细弹层 ---------- */
.shamt-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 40rpx 36rpx 0;
}

.shamt {
  display: flex;
  align-items: baseline;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.shamt.exp { color: #d9433f; }
.shamt.inc { color: #1f7a4d; }
.shamt.muted { color: #6b8f7f; }

.shsign {
  font-size: 32rpx;
  margin-right: 2rpx;
}

.shdir {
  flex: 1;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  align-self: center;
}

.shdir.exp { color: #d9433f; background: #fdf1f0; }
.shdir.inc { color: #1f7a4d; background: #eef6f1; }
.shdir.muted { color: #6b8f7f; background: #f1f4f2; }

.shclose {
  font-size: 26rpx;
  color: #8b9198;
  padding-left: 20rpx;
  align-self: center;
}

.shmerchant {
  padding: 14rpx 36rpx 24rpx;
  font-size: 28rpx;
  color: #2b3339;
  font-weight: 500;
}

.shcard {
  margin: 0 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.srow {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eff1f2;
}

.srow:last-child {
  border-bottom: none;
}

.sl {
  width: 120rpx;
  flex: none;
  font-size: 24rpx;
  color: #9aa0a6;
}

.sv {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #2b3339;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sv-wrap {
  white-space: normal;
  line-height: 1.45;
  text-align: right;
}

.sv-dim {
  color: #b1b7bd;
}

.sv-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.scatdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex: none;
}

.shacts {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
}

.act {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--brand, #17806b);
  background: #e3f0ec;
}

.act.on {
  background: var(--brand, #17806b);
  color: #ffffff;
}

.act.danger {
  color: #d9433f;
  background: #fdf1f0;
}

.shlist {
  max-height: 520rpx;
  margin-top: 8rpx;
}

.shcat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 36rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f7f8f9;
}

.shcat.on {
  color: var(--brand, #17806b);
  font-weight: 600;
}

.shcheck {
  color: var(--brand, #17806b);
}
.scope-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 24rpx; }
.scope-caption { font-size: 23rpx; color: #7a8882; white-space: nowrap; }
.scope-segment { display: flex; background: #f0f4f2; padding: 5rpx; border-radius: 14rpx; }
.scope-segment .chip { padding: 10rpx 16rpx; font-size: 22rpx; background: transparent; border-radius: 10rpx; }
.scope-segment .chip.on { background: #ffffff; }
.toolbar-spacer { flex: 1; }
.toolbar-action { padding: 10rpx 14rpx; font-size: 24rpx; color: var(--brand); }
.toolbar { margin-top: 18rpx; }
.active-filters { margin-top: 12rpx; }
.empty-link { color: var(--brand); margin-top: 20rpx; padding: 14rpx; }
.iamt, .sumi, .gspend, .shnum { font-variant-numeric: tabular-nums; }
.sumrow { gap: 16rpx; flex-wrap: wrap; }
.tip { padding-left: 24rpx; padding-right: 24rpx; line-height: 1.7; }
.page.dark { background: #111916; color: #e5eee9; }
.dark .bar, .dark .items, .dark .sheet { background: #1b2421; }
.dark .search, .dark .chip, .dark .shcard, .dark .scope-segment { background: #24332c; }
.dark .chip.on, .dark .scope-segment .chip.on, .dark .act { background: #30463b; color: #a4d4c2; }
.dark .sinput, .dark .sv, .dark .shmerchant { color: #e5eee9; }
.dark .item, .dark .items, .dark .srow, .dark .shcat { border-color: #2c3831; }
.dark .gday, .dark .gspend, .dark .isub, .dark .tip, .dark .refnote, .dark .sl, .dark .sv-dim, .dark .scope-caption, .dark .cny-equivalent, .dark .transfer-native { color: #a0b0a7; }
.dark .toolbar-action, .dark .empty-link, .dark .nav { color: #93cdb8; }
.dark .nav.off { color: #59695f; }
.dark .ic { opacity: .85; }
.dark .act.danger { background: #462f2d; color: #efb0a3; }
.dark .bytag { background: #403a2d; color: #d8c18a; }
/* 深色补充：筛选 chip 与标记胶囊在暗底上要能看清 */
.dark .chip { background: #24332c; color: #b9c7c0; }
.dark .chip.on { background: #1f4237; color: #a8e0c9; }
.dark .chip.back { background: var(--brand, #17806b); color: #ffffff; }

.saved-strip { white-space: nowrap; margin-top: 12rpx; }
.saved-chip { display: inline-flex; align-items: center; margin-right: 12rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: #f2f3f5; color: #5a6169; font-size: 22rpx; }
.saved-chip.on { background: #e3f0ec; color: var(--brand, #17806b); }
.saved-del { margin-left: 12rpx; padding: 0 4rpx; color: #9aa0a6; }
.fmask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.35); z-index: 110; }
.fpanel { position: absolute; left: 0; right: 0; bottom: 0; max-height: 88vh; overflow-y: auto; box-sizing: border-box; padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #ffffff; }
.fhead { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 600; }
.fclose { color: var(--brand, #17806b); font-size: 25rpx; font-weight: 500; }
.fsection { margin-top: 26rpx; }
.flabel { display: block; margin-bottom: 12rpx; font-size: 23rpx; color: #7a8480; }
.frow { display: flex; align-items: center; gap: 14rpx; }
.frow > picker { flex: 1; min-width: 0; }
.finput { flex: 1; min-width: 0; padding: 18rpx 20rpx; border-radius: 14rpx; background: #f4f6f5; font-size: 25rpx; }
.fsep { flex: none; color: #9aa0a6; font-size: 22rpx; }
.fcats { margin-top: 0; max-height: 220rpx; overflow-y: auto; }
.fpicker { padding: 18rpx 20rpx; border-radius: 14rpx; background: #f4f6f5; font-size: 25rpx; }
.fswitch { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; font-size: 25rpx; }
.fswitch switch { transform: scale(.82); transform-origin: right center; }
.factions { display: flex; gap: 14rpx; margin-top: 30rpx; }
.fbtn { flex: 1; padding: 20rpx 10rpx; border-radius: 16rpx; text-align: center; font-size: 25rpx; color: #ffffff; background: var(--brand, #17806b); }
.fbtn.plain { color: var(--brand, #17806b); background: #e3f0ec; }
.dark .saved-chip, .dark .finput, .dark .fpicker { background: #24332c; color: #dce7e1; }
.dark .saved-chip.on { background: #1f4237; color: #a8e0c9; }
.dark .fpanel { background: #1b2421; color: #e5eee9; }
.dark .flabel { color: #a0b0a7; }
.dark .fbtn.plain { background: #30463b; color: #a4d4c2; }
