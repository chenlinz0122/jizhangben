/* pages/promo/promo - 推广得会员 */
.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 0 0 60rpx;
}

.hero {
  padding: 40rpx 32rpx 56rpx;
  background: linear-gradient(160deg, #2f6f5e 0%, #1f5145 100%);
}

.h1 {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.h2 {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.card {
  margin: -24rpx 24rpx 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(30, 45, 40, 0.06);
}

.card + .card {
  margin-top: 20rpx;
}

.card:first-of-type {
  margin-top: -40rpx;
}

.ct {
  font-size: 30rpx;
  font-weight: 700;
  color: #242a2e;
  margin-bottom: 18rpx;
}

/* 三档门槛 */
.tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #f3f7f5;
  margin-bottom: 12rpx;
}

.tl {
  display: flex;
  flex-direction: column;
}

.tv {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f6f5e;
}

.tb {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b9399;
}

.tname {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #2f6f5e;
  background: #ffffff;
  border-radius: 999rpx;
}

.note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8b9399;
}

.li {
  font-size: 25rpx;
  line-height: 1.85;
  color: #4c5458;
}

/* 表单 */
.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.row.top {
  align-items: flex-start;
}

.lab {
  width: 150rpx;
  font-size: 25rpx;
  color: #7c848a;
}

.ipt {
  flex: 1;
  font-size: 26rpx;
  color: #242a2e;
}

.plats {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.pl {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #5a6368;
  background: #f4f5f7;
  border-radius: 999rpx;
}

.pl.on {
  color: #ffffff;
  background: #2f6f5e;
}

.shot {
  flex: 1;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa2a8;
  border: 1rpx dashed #d8dde1;
  border-radius: 16rpx;
}

.shotbox {
  flex: 1;
  display: flex;
  align-items: center;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
}

.del {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #9aa2a8;
}

.err {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #d0563f;
}

.btn {
  margin-top: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #2f6f5e;
  border-radius: 999rpx;
}

.btn::after {
  border: none;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9aa2a8;
}

.foot {
  margin: 8rpx 24rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
  color: #a5abb0;
}

/* 深色跟随系统 */
.page.dark {
  background: #12161a;
}

.page.dark .card {
  background: #1b2026;
  box-shadow: none;
}

.page.dark .ct {
  color: #e6e9ec;
}

.page.dark .tier {
  background: #22282e;
}

.page.dark .li,
.page.dark .ipt {
  color: #cfd5da;
}

.page.dark .row {
  border-color: #262c33;
}

.page.dark .pl {
  background: #22282e;
  color: #b6bfc5;
}

.page.dark .pl.on {
  background: #2f6f5e;
  color: #ffffff;
}
