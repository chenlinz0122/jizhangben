<view class="theme-{{themeKey}} page {{dark ? 'dark' : ''}}">
  <!-- 从总览跳过来时给一个返回（switchTab 没有原生返回箭头） -->
  <view class="rback" wx:if="{{backTab}}" bindtap="goBack">‹ 返回{{backLabel}}</view>
  <!-- 顶部大数字卡：支出 / 入账 两个页签 -->
  <view class="hero {{tab === 'income' ? 'hi' : ''}}">
    <view class="hrow">
      <text class="hnav" bindtap="prevMonth">‹</text>
      <picker mode="date" fields="month" value="{{ym}}" end="{{maxYm}}" bindchange="pickMonth"><text class="hmonth">{{monthText}}</text></picker>
      <text class="hnav {{canNext ? '' : 'off'}}" bindtap="nextMonth">›</text>
      <view class="seg">
        <text class="sg {{tab === 'expense' ? 'on' : ''}}" data-tab="expense" bindtap="switchTab">支出</text>
        <text class="sg {{tab === 'income' ? 'on' : ''}}" data-tab="income" bindtap="switchTab">入账</text>
      </view>
    </view>

    <text class="hlab">{{tab === 'income' ? '共入账' : (s.refundOut ? '净支出' : '共支出')}}</text>
    <text class="hnum">¥{{tab === 'income' ? s.incomeText : s.expenseText}}</text>

    <view class="hfoot">
      <text>{{s.count}} 笔流水</text>
      <text class="hdot">·</text>
      <text>收支结余 {{s.netSign}}¥{{s.netText}}</text>
      <block wx:if="{{s.investText !== '0.00'}}">
        <text class="hdot">·</text>
        <text>理财 ¥{{s.investText}} 未计入</text>
      </block>
      <block wx:if="{{s.acctText !== '0.00'}}">
        <text class="hdot">·</text>
        <text>账户转移 ¥{{s.acctText}} 未计入</text>
      </block>
    </view>

    <!-- 退款单独一行：和上方流水数字分开，别把口径说明挤成一串 -->
    <view class="hnote" wx:if="{{s.refundText !== '0.00'}}" bindtap="toggleRefund">
      <text>退款 ¥{{s.refundText}} · {{s.refundOut ? '按到账日抵减支出' : '按到账日计入入账'}}</text>
      <text class="hnote-act">改口径 ›</text>
    </view>

    <!-- 共同账本视角：只看自己 / 看双方 / 只看对方（没加入账本时不显示） -->
    <view class="scopebar" wx:if="{{sharedOn}}">
      <text class="schip {{scope === 'mine' ? 'on' : ''}}" data-k="mine" bindtap="setScope">只看自己</text>
      <text class="schip {{scope === 'both' ? 'on' : ''}}" data-k="both" bindtap="setScope">看双方{{sharedMembers > 1 ? ' ·' + sharedMembers + '人' : ''}}</text>
      <text class="schip {{scope === 'peer' ? 'on' : ''}}" data-k="peer" bindtap="setScope">只看对方</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!hasData}}">这个月还没有数据，先记一笔再说</view>

  <!-- 构成：环形图 + 分类（可展开） -->
  <view class="card" wx:if="{{cats.length > 0}}">
    <view class="between">
      <text class="title inline">{{tab === 'income' ? '入账构成' : (s.refundOut ? '净支出构成' : '支出构成')}}</text>
      <text class="muted2">点分类看明细</text>
    </view>
    <view class="piebox">
      <block wx:if="{{!hidePie}}">
        <canvas type="2d" id="pie" wx:if="{{tab === 'expense'}}" class="pie"></canvas>
        <canvas type="2d" id="piein" wx:else class="pie"></canvas>
      </block>
      <view wx:else class="pie pie-ph"></view>
    </view>

    <view class="cat {{item.negative ? 'negative' : ''}}" wx:for="{{cats}}" wx:key="name" data-name="{{item.name}}" bindtap="tapCat">
      <view class="between">
        <view class="left">
          <view class="ic" style="background:{{item.tint}}"><text class="ic-em">{{item.icon}}</text></view>
          <text class="cname">{{item.name}}</text>
          <text class="delta {{item.deltaDir}}" wx:if="{{item.deltaText}}">{{item.deltaText}}</text>
        </view>
        <text class="camt">¥{{item.amountText}}</text>
      </view>
      <view class="track" wx:if="{{!item.negative}}">
        <view class="fill" style="width:{{item.pct}}%;background:{{item.color}}"></view>
      </view>
      <text class="cmeta">{{item.negative ? '退款抵减项，不计占比' : '占比 ' + item.pct + '% · ' + item.count + ' 笔'}}</text>
      <text class="cbmeta {{item.budgetOver ? 'over' : ''}}" wx:if="{{item.budget > 0}}">分类预算 ¥{{item.budgetText}} · 已用 ¥{{item.budgetSpentText}} · {{item.budgetPct}}%<text wx:if="{{item.budgetRefundText}}">（本月抵减 ¥{{item.budgetRefundText}}，已用最低为 0）</text></text>
    </view>

    <view class="more" wx:if="{{catsHasMore}}" bindtap="toggleCats">
      {{catsOpen ? '收起' : '展开全部 ' + catsTotal + ' 类'}}
    </view>
  </view>

  <!-- 免费版到这儿就断了：把锁住的东西列清楚，别让人以为报表坏了 -->
  <view class="upsell" wx:if="{{locked}}">
    <view class="up-head">
      <text class="up-title">想解锁更多？</text>
      <text class="up-badge">会员</text>
    </view>
    <text class="up-desc">开通后解锁：每日支出趋势 · 近 6 个月对比 · 年度汇总 · 商户排行 · 每日花销日历 · 月度预算 · AI 补分类</text>
    <view class="up-btn" bindtap="goVip">输入卡密开通</view>
    <text class="up-hint">有卡密直接点上面输；没有就先去拿一张</text>
  </view>

  <!-- 被锁的卡片不做成「消失」，而是灰化占位：让人知道这里本来有东西 -->
  <view class="tease" wx:if="{{locked}}">
    <view class="tag-card" wx:for="{{teasers}}" wx:key="name" bindtap="goVip">
      <view class="tc-head">
        <text class="tc-name">{{item.name}}</text>
        <text class="tc-lock">会员</text>
      </view>
      <view class="tc-bar" wx:for="{{item.bars}}" wx:for-item="w" wx:for-index="wi" wx:key="*this" style="width:{{w}}"></view>
      <text class="tc-hint">{{item.hint}}</text>
    </view>
  </view>

  <!-- 每日对比（可放大缩小） -->
  <view class="card" wx:if="{{hasData && !locked}}">
    <view class="between">
      <text class="title inline">{{tab === 'income' ? '每日入账' : (s.refundOut ? '每日净支出' : '每日支出')}}</text>
      <view class="zoomwrap">
        <text class="zbtn {{dayZoom === 1 ? 'off' : ''}}" data-d="-1" bindtap="zoomDay">−</text>
        <text class="zval">{{dayZoom}}×</text>
        <text class="zbtn {{dayZoom === 3 ? 'off' : ''}}" data-d="1" bindtap="zoomDay">＋</text>
      </view>
    </view>
    <view class="dhint">
      <text class="muted2">{{dayZoom > 1 ? '左右滑动看全月 · 点柱子看当天明细' : '点柱子看当天明细'}}</text>
      <text class="muted2" wx:if="{{dayZoom > 1 && daily.show}}">{{daily.tipText}}</text>
    </view>

    <view class="dwrap {{dayZoom > 1 ? 'tight' : ''}}">
      <block wx:if="{{dayZoom === 1}}">
        <view class="dbubble" wx:if="{{daily.show}}" style="left:{{daily.tipLeft}}%">{{daily.tipText}}</view>
        <view class="dchart">
          <view class="dcol" wx:for="{{daily.list}}" wx:key="d" data-d="{{item.d}}" bindtap="tapDaily">
            <view class="dbar {{item.isMax ? 'max' : ''}} {{tab}} {{item.negative ? 'net-refund' : ''}} {{item.zero ? 'zero' : ''}}" style="height:{{item.h}}%"></view>
          </view>
        </view>
        <view class="xaxis">
          <text>{{daily.x1}}</text>
          <text>{{daily.x2}}</text>
          <text>{{daily.x3}}</text>
          <text>{{daily.x4}}</text>
        </view>
      </block>

      <scroll-view wx:else scroll-x class="dscroll" show-scrollbar="{{false}}">
        <view class="din" style="width:{{dInW}}rpx">
          <view class="dchart" style="width:{{dInW}}rpx">
            <view class="dcolz" style="width:{{dColW}}rpx" wx:for="{{daily.list}}" wx:key="d"
                  data-d="{{item.d}}" bindtap="tapDaily">
              <view class="dbar {{item.isMax ? 'max' : ''}} {{tab}} {{item.negative ? 'net-refund' : ''}} {{item.zero ? 'zero' : ''}}" style="height:{{item.h}}%"></view>
            </view>
          </view>
          <view class="daxis" style="width:{{dInW}}rpx">
            <text class="dax" style="width:{{dColW}}rpx" wx:for="{{daily.list}}" wx:key="d">{{item.ax}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 月度对比（近 6 个月，可左右滑动） -->
  <view class="card {{tab === 'income' ? 'hi' : ''}}" wx:if="{{hasData && !locked}}">
    <view class="between">
      <text class="title inline">{{tab === 'income' ? '入账' : (s.refundOut ? '净支出' : '支出')}}对比 · 近 6 个月</text>
      <text class="muted2">左右滑动 · 点柱子看明细</text>
    </view>
    <scroll-view scroll-x enable-flex class="mscroll" show-scrollbar="{{false}}"
                 scroll-into-view="{{scrollToId}}" scroll-with-animation>
      <view class="mchart" style="width:{{chartW}}rpx">
        <view class="mcol" wx:for="{{months}}" wx:key="ym" id="m{{index}}" data-ym="{{item.ym}}" bindtap="tapBar">
          <text class="mval {{item.active ? 'on' : ''}} {{item.negative ? 'negative' : ''}}">¥{{item.text}}</text>
          <view class="mbararea">
            <view class="mbar {{tab}} {{item.active ? 'on' : ''}} {{item.negative ? 'net-refund' : ''}} {{item.zero ? 'zero' : ''}}" style="height:{{item.h}}%"></view>
          </view>
          <text class="mlab {{item.active ? 'on' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 年度汇总（自然年累计） -->
  <view class="card" wx:if="{{year && year.count > 0 && !locked}}">
    <view class="between">
      <text class="title inline">{{year.year}} 年度汇总</text>
      <view class="yseg">
        <text class="ysg {{yearTab === 'expense' ? 'on' : ''}}" data-tab="expense" bindtap="switchYearTab">支出</text>
        <text class="ysg {{yearTab === 'income' ? 'on' : ''}}" data-tab="income" bindtap="switchYearTab">入账</text>
      </view>
    </view>
    <text class="ysub">自然年累计 · {{year.count}} 笔</text>
    <text class="link annual-link" bindtap="goAnnual">查看完整年度报告 ›</text>
    <view class="ygrid">
      <view class="ycell">
        <text class="yn">¥{{year.expenseText}}</text>
        <text class="yl">{{s.refundOut ? '年净支出' : '年支出'}}</text>
      </view>
      <view class="ycell">
        <text class="yn">¥{{year.incomeText}}</text>
        <text class="yl">年入账</text>
      </view>
      <view class="ycell">
        <text class="yn">{{year.netSign}}¥{{year.netText}}</text>
        <text class="yl">年结余</text>
      </view>
    </view>
    <view class="ytop" wx:if="{{year.top.length > 0}}">
      <view class="between">
        <text class="ytlabel">{{year.topLabel}}</text>
        <text class="muted2">点分类看明细</text>
      </view>
      <view class="yrow {{item.negative ? 'negative' : ''}}" wx:for="{{year.top}}" wx:key="name" data-name="{{item.name}}" bindtap="tapYearCat">
        <view class="between">
          <text class="yrowname">{{item.name}}</text>
          <text class="yrowamt {{yearTab === 'income' ? 'yinc' : ''}}">¥{{item.amountText}}</text>
        </view>
        <view class="ybar" wx:if="{{!item.negative}}">
          <view class="ybarfill" style="width:{{item.barPct}}%;background:{{item.color}}"></view>
        </view>
        <text class="yrowmeta">{{item.negative ? '退款抵减项' : ((yearTab === 'expense' && s.refundOut ? '正支出占比 ' : '占比 ') + item.pct + '%')}} · {{item.count}} 笔</text>
      </view>
      <view class="more" wx:if="{{year.topMore}}" bindtap="toggleYearCats">{{year.moreLabel}}</view>
    </view>
  </view>

  <!-- 商户排行：支出榜 + 入账榜并排给，当前页签对应的那个在前 -->
  <view class="card" wx:if="{{rankAny && !locked}}">
    <view class="title">商户排行</view>
    <block wx:for="{{rankBoards}}" wx:for-item="board" wx:for-index="bi" wx:key="key">
      <view class="rhead" wx:if="{{board.list.length > 0}}">
        <text class="rhtitle">{{board.title}}</text>
        <text class="rhsub">{{board.sub}}</text>
      </view>
      <view class="mrow" wx:for="{{board.list}}" wx:for-item="row" wx:for-index="ri" wx:key="name">
        <text class="mrank {{ri < 3 ? 'top' : ''}}">{{ri + 1}}</text>
        <view class="mcol2">
          <text class="mname">{{row.name}}</text>
          <text class="mcat">{{row.cat}} · {{row.count}} 笔</text>
        </view>
        <text class="mamt {{board.inc ? 'inc' : ''}} {{row.negative ? 'negative' : ''}}">¥{{row.amountText}}</text>
      </view>
    </block>
  </view>

  <!-- 洞察 -->
  <view class="card" wx:if="{{hasData && tab === 'expense' && !locked}}">
    <view class="title">这个月的情况</view>
    <view class="igrid">
      <view class="icell">
        <text class="in">日均净支出</text>
        <text class="iv">¥{{avgDailyText}}</text>
      </view>
      <view class="icell">
        <text class="in">最大付款（原额）</text>
        <text class="iv">¥{{maxAmountText}}</text>
        <text class="isub">{{maxMerchant}}</text>
      </view>
      <view class="icell">
        <text class="in">有花钱的天数</text>
        <text class="iv">{{spentDays}} 天</text>
      </view>
      <view class="icell">
        <text class="in">工作日 / 周末净支出</text>
        <text class="iv small">¥{{weekdayText}} / ¥{{weekendText}}</text>
      </view>
    </view>
  </view>

  <!-- 预算（只对支出有意义） -->
  <view class="card" id="budget-card" wx:if="{{tab === 'expense' && !locked}}">
    <view class="between">
      <text class="title inline">月度预算</text>
      <view class="links">
        <text class="link" bindtap="toggleCatBudget">{{catBudgetOpen ? '收起分类预算' : '分类预算'}}</text>
        <text class="link" bindtap="goBudgetTemplates">模板</text>
        <text class="link" bindtap="goBudgetVariance">偏差分析</text>
        <text class="link" bindtap="goBudgetHistory">历史</text>
        <text class="link" bindtap="setBudget">{{budget > 0 ? '修改' : '设置'}}</text>
      </view>
    </view>

    <block wx:if="{{budget > 0}}">
      <view class="between bline">
        <text>已用 ¥{{budgetSpentText}} / 预算 ¥{{budgetText}}</text>
        <text class="bpct {{budgetOver ? 'over' : ''}}">{{budgetPct}}%</text>
      </view>
      <view class="track big">
        <view class="fill {{budgetOver ? 'over' : ''}}" style="width:{{budgetPct}}%"></view>
      </view>
      <text class="bsub" wx:if="{{budgetOver}}">已经超了 ¥{{budgetOverText}}，这个月剩下的日子得收着点</text>
      <text class="bsub" wx:elif="{{isCurMonth}}">还剩 ¥{{budgetLeftText}}，剩 {{budgetRestDays}} 天，每天还能花 ¥{{budgetPerDayText}}</text>
      <text class="bsub" wx:else>还剩 ¥{{budgetLeftText}}</text>
    </block>

    <text class="hint" wx:else>设一个月度预算，超了这里会变红提醒你。随时能改。</text>
    <text class="hint">预算已用 = 本月付款 − 本月退款，最低为 0，不随退款展示口径改变；报表净支出可以为负数。<text wx:if="{{budgetRefundText !== '0.00'}}">本月退款 ¥{{budgetRefundText}}。</text></text>

    <!-- 分类预算清单：类目一次列全，点一行填额度 -->
    <view class="cblist" wx:if="{{catBudgetOpen}}">
      <text class="hint">点类目填额度，填 0 取消。分类预算已用最低为 0；退款在到账月抵减配对付款的分类，未配对退款单列，不随意归给其他商户或分类。</text>
      <view class="cbrow" wx:for="{{catBudgetList}}" wx:key="name" data-name="{{item.name}}" bindtap="pickCatBudget">
        <view class="cbleft">
          <view class="ic" style="background:{{item.tint}}"><text class="ic-em">{{item.icon}}</text></view>
          <text class="cbname">{{item.name}}</text>
        </view>
        <view class="cbright">
          <text class="cbspent">已用 ¥{{item.spentText}}</text>
          <text class="cbbud {{item.budClass}}">{{item.budgetLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 每日花销日历 -->
  <view class="card" wx:if="{{hasData && tab === 'expense' && !locked}}">
    <view class="title">{{s.refundOut ? '每日净支出日历' : '每日支出日历'}}</view>
    <view class="calweek">
      <text class="cw">日</text>
      <text class="cw">一</text>
      <text class="cw">二</text>
      <text class="cw">三</text>
      <text class="cw">四</text>
      <text class="cw">五</text>
      <text class="cw">六</text>
    </view>
    <view class="cal">
      <view class="cell {{item.blank ? 'blank' : 'lv' + item.level}} {{item.negative ? 'net-refund' : ''}}"
            wx:for="{{cells}}" wx:key="k" data-item="{{item}}" bindtap="tapDay">
        <text class="cd" wx:if="{{!item.blank}}">{{item.d}}</text>
        <text class="cal-minus" wx:if="{{item.negative}}">−</text>
      </view>
    </view>
    <view class="calsel">按实际发生日期计入 · 点格子看当天明细</view>
    <view class="legend">
      <text class="lgtext">少</text>
      <view class="sw lv0"></view>
      <view class="sw lv1"></view>
      <view class="sw lv2"></view>
      <view class="sw lv3"></view>
      <view class="sw lv4"></view>
      <text class="lgtext">多</text>
    </view>
  </view>

  <view class="card aicat" wx:if="{{uncatCount > 0 && !locked}}">
    <view class="aicat-row">
      <view class="aicat-main">
        <view class="aicat-t">还有 {{uncatCount}} 笔没分类</view>
        <view class="aicat-s">词库没认出来的，让 AI 按商户名判一下；结果先给你过目，确认了才写进去</view>
      </view>
      <view class="aicat-btn" bindtap="aiFill">AI 补分类</view>
    </view>
  </view>

  <view class="tools" id="data-tools">
    <view class="btn plain" bindtap="backup">备份数据（导出 JSON）</view>
    <view class="btn plain" bindtap="restore">恢复数据（选备份文件）</view>
    <view class="btn plain" bindtap="exportCsv">复制 CSV（发到电脑看）</view>
    <view class="danger" bindtap="clearAll">清空所有数据</view>
  </view>
</view>
