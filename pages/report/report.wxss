.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ---------- 顶部大数字 ---------- */
/* 注意：这里不能用 position: sticky。
   canvas 是原生组件，真机上不吃 z-index，只要环形图滚到吸顶头部下面，
   它就会浮在绿色卡片之上把大数字盖掉。 */
.hero {
  background: linear-gradient(160deg, #1a8f76 0%, #12695a 100%);
  padding: 26rpx 32rpx 34rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 105, 90, 0.18);
}

.hero.hi {
  background: linear-gradient(160deg, #b89a6d 0%, #967f52 100%);
}

.hrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hnav {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.85);
  width: 36rpx;
  text-align: center;
}

.hnav.off {
  color: rgba(255, 255, 255, 0.3);
}

.hmonth {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.seg {
  margin-left: auto;
  display: flex;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 4rpx;
}

.sg {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
}

.sg.on {
  background: #ffffff;
  color: #17806b;
  font-weight: 600;
}

.hi .sg.on {
  color: #967f52;
}

.hlab {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 22rpx;
}

.hnum {
  display: block;
  font-size: 62rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
  line-height: 1.2;
}

.hfoot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hdot {
  margin: 0 10rpx;
}

.empty {
  margin: 40rpx 24rpx;
  padding: 60rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(23, 128, 107, 0.06);
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a6;
  line-height: 1.8;
}

/* ---------- 分类 ---------- */
.cat {
  margin-bottom: 26rpx;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
}

.cat:active {
  background: #f5f8f7;
}

.cname {
  font-size: 26rpx;
}

.camt {
  font-size: 23rpx;
  color: #8b9198;
}

.track {
  height: 12rpx;
  background: #eff1f3;
  border-radius: 8rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.fill {
  height: 12rpx;
  border-radius: 8rpx;
  min-width: 6rpx;
}

.more {
  text-align: center;
  font-size: 22rpx;
  color: #17806b;
  padding: 10rpx 0 4rpx;
}

/* ---------- 每日柱状 ---------- */
.zoomwrap {
  display: flex;
  align-items: center;
  background: #f1f4f3;
  border-radius: 20rpx;
  padding: 4rpx;
}

.zbtn {
  width: 52rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1;
  color: #17806b;
  padding: 8rpx 0;
}

.zbtn.off {
  color: #c4c9cd;
}

.zval {
  font-size: 20rpx;
  color: #5b6167;
  min-width: 42rpx;
  text-align: center;
}

.dhint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.dwrap {
  position: relative;
  padding-top: 56rpx;
}

.dwrap.tight {
  padding-top: 14rpx;
}

/* 放大后：柱子定宽 + 横向滑动 */
.dscroll {
  width: 100%;
}

.din {
  padding-bottom: 4rpx;
}

.dcolz {
  flex: none;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.daxis {
  display: flex;
  margin-top: 8rpx;
}

.dax {
  flex: none;
  text-align: center;
  font-size: 19rpx;
  color: #b1b7bd;
  white-space: nowrap;
}

.dbubble {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  background: #2b3136;
  color: #ffffff;
  font-size: 19rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dchart {
  display: flex;
  align-items: flex-end;
  height: 190rpx;
  border-bottom: 1rpx solid #eceef0;
}

.dcol {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.dbar {
  width: 68%;
  min-height: 4rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #d7dee0;
}

.dbar.expense {
  background: #cbbfbd;
}

.dbar.expense.max {
  background: #d9433f;
}

.dbar.income {
  background: #e2d8c6;
}

.dbar.income.max {
  background: #b89a6d;
}

.xaxis {
  display: flex;
  justify-content: space-between;
  font-size: 19rpx;
  color: #b1b7bd;
  margin-top: 8rpx;
}

/* ---------- 月度对比 ---------- */
.mscroll {
  white-space: nowrap;
  width: 100%;
  margin-top: 20rpx;
}

.mchart {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding-bottom: 4rpx;
}

.mcol {
  width: 140rpx;
  flex: none;
  margin-right: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mval {
  font-size: 18rpx;
  color: #b1b7bd;
  margin-bottom: 6rpx;
  transform: scale(0.92);
}

.mval.on {
  color: #17806b;
  font-weight: 600;
}

.hi .mval.on {
  color: #b89a6d;
}

.mbararea {
  position: relative;
  width: 100%;
  height: 210rpx;
}

.mbar {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  min-height: 4rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #dde2e4;
}

.mbar.expense.on {
  background: #17806b;
}

.mbar.income.on {
  background: #b89a6d;
}

.mbar.expense {
  background: #c8d8d3;
}

.mbar.income {
  background: #ddd2b9;
}

.mlab {
  font-size: 20rpx;
  color: #9aa0a6;
  margin-top: 10rpx;
}

.mlab.on {
  color: #17806b;
  font-weight: 600;
}

.hi .mlab.on {
  color: #b89a6d;
}

.muted2 {
  font-size: 19rpx;
  color: #b1b7bd;
}

/* ---------- 排行 ---------- */
.mrow {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f5f6;
}

.mrow:last-child {
  border-bottom: none;
}

.mrank {
  width: 40rpx;
  font-size: 22rpx;
  color: #b1b7bd;
  font-weight: 600;
}

.mrank.top {
  color: #17806b;
}

.mcol2 {
  flex: 1;
  overflow: hidden;
}

.mname {
  display: block;
  font-size: 26rpx;
  color: #2b3136;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mcat {
  display: block;
  font-size: 19rpx;
  color: #b1b7bd;
  margin-top: 2rpx;
}

.mamt {
  font-size: 26rpx;
  font-weight: 600;
  color: #d9433f;
  margin-left: 16rpx;
}

.mamt.inc {
  color: #1f7a4d;
}

/* ---------- 环形图 ---------- */
.piebox {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin: 8rpx auto 32rpx;
}

.pie {
  width: 320rpx;
  height: 320rpx;
}

/* ---------- 分类行 -------- */
.left {
  display: flex;
  align-items: center;
}

.ic {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-em {
  font-size: 26rpx;
  line-height: 1;
}

.delta {
  font-size: 19rpx;
  margin-left: 12rpx;
  color: #b1b7bd;
}

.delta.up {
  color: #d9433f;
}

.delta.down {
  color: #1f7a4d;
}

.cmeta {
  display: block;
  font-size: 19rpx;
  color: #b1b7bd;
  margin-top: 6rpx;
}

.cbmeta {
  display: block;
  font-size: 19rpx;
  color: #5f887c;
  margin-top: 4rpx;
}

.cbmeta.over {
  color: #d9433f;
}

/* ---------- 洞察四格 ---------- */
.igrid {
  display: flex;
  flex-wrap: wrap;
}

.icell {
  width: 50%;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.in {
  display: block;
  font-size: 21rpx;
  color: #9aa0a6;
}

.iv {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3136;
  margin-top: 6rpx;
}

.iv.small {
  font-size: 24rpx;
}

.isub {
  display: block;
  font-size: 19rpx;
  color: #b1b7bd;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 预算 ---------- */
.title.inline {
  margin-bottom: 0;
}

.link {
  font-size: 24rpx;
  color: #17806b;
}

.links {
  display: flex;
  gap: 24rpx;
}

.bline {
  font-size: 24rpx;
  color: #5b6167;
  margin: 20rpx 0 8rpx;
}

.bpct {
  font-weight: 600;
  color: #17806b;
}

.bpct.over {
  color: #d9433f;
}

.track.big {
  height: 18rpx;
  border-radius: 9rpx;
}

.track.big .fill {
  height: 18rpx;
  border-radius: 9rpx;
}

.fill.over {
  background: #d9433f !important;
}

.bsub {
  display: block;
  font-size: 22rpx;
  color: #8b9198;
  margin-top: 14rpx;
  line-height: 1.6;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: #a2a8ae;
  line-height: 1.7;
}

/* ---------- 分类预算清单 ---------- */
.cblist {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f3f4;
}

.cbrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f6f7f8;
}

.cbrow:last-child {
  border-bottom: none;
}

.cbleft {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.cbname {
  font-size: 26rpx;
  color: #2b3136;
}

.cbright {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
}

.cbspent {
  font-size: 21rpx;
  color: #b1b7bd;
}

.cbbud {
  font-size: 24rpx;
  font-weight: 500;
  color: #17806b;
}

.cbbud.off {
  color: #c4c9cd;
  font-weight: 400;
}

.cbbud.over {
  color: #d9433f;
}

/* ---------- 日历热力 ---------- */
.calweek {
  display: flex;
  margin-bottom: 8rpx;
}

.cw {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #b1b7bd;
  margin-right: 8rpx;
}

.cw:last-child {
  margin-right: 0;
}

.cal {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: calc(14.2857% - 8rpx);
  height: 76rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cell:nth-child(7n) {
  margin-right: 0;
}

.cell.blank {
  background: transparent;
}

.cell.lv0 {
  background: #f7f8f9;
}

.cell.lv1 {
  background: #e9efec;
}

.cell.lv2 {
  background: #c4d9cd;
}

.cell.lv3 {
  background: #8fbfa8;
}

.cell.lv4 {
  background: #17806b;
}

.cd {
  font-size: 22rpx;
  color: #5b6167;
}

.cell.lv3 .cd,
.cell.lv4 .cd {
  color: #ffffff;
  font-weight: 600;
}

.calsel {
  font-size: 22rpx;
  color: #8b9198;
  text-align: center;
  margin-top: 12rpx;
}

.sw {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin: 0 6rpx;
  display: inline-block;
}

.sw.lv0 { background: #f7f8f9; }
.sw.lv1 { background: #e9efec; }
.sw.lv2 { background: #c4d9cd; }
.sw.lv3 { background: #8fbfa8; }
.sw.lv4 { background: #17806b; }

.lgtext {
  font-size: 20rpx;
  color: #a2a8ae;
}

.legend {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  align-items: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8b9198;
}

/* ---------- 底部工具 ---------- */
.tools {
  margin: 8rpx 24rpx 0;
}

.tools .btn {
  margin-bottom: 20rpx;
}

/* ---------- 年度汇总 ---------- */
.ygrid {
  display: flex;
  margin-top: 16rpx;
}

.ycell {
  flex: 1;
  text-align: center;
}

.yn {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3136;
}

.yl {
  display: block;
  font-size: 21rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.ytop {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f3f4;
}

.ytlabel {
  font-size: 22rpx;
  color: #9aa0a6;
}

.ysub {
  display: block;
  font-size: 20rpx;
  color: #b1b7bd;
  margin-top: 6rpx;
  margin-bottom: 4rpx;
}

/* 支出 / 入账 切换：跟顶部那个页签一个意思，但这是卡片内的浅色版本 */
.yseg {
  display: flex;
  background: #f1f4f3;
  border-radius: 22rpx;
  padding: 4rpx;
}

.ysg {
  font-size: 21rpx;
  color: #8b9198;
  padding: 8rpx 20rpx;
  border-radius: 18rpx;
}

.ysg.on {
  background: #ffffff;
  color: #17806b;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(23, 128, 107, 0.12);
}

/* 分类行：名称 + 金额 / 条形 / 占比 · 笔数 */
.yrow {
  padding: 14rpx 0 12rpx;
  border-radius: 12rpx;
}

.yrow:active {
  background: #f6f9f8;
}

.yrowname {
  font-size: 26rpx;
  color: #33383e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.yrowamt {
  font-size: 26rpx;
  color: #2b3136;
  font-weight: 600;
  margin-left: 20rpx;
  white-space: nowrap;
}

.yrowamt.yinc {
  color: #1f7a4d;
}

.ybar {
  height: 10rpx;
  background: #eff1f3;
  border-radius: 6rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.ybarfill {
  height: 10rpx;
  border-radius: 6rpx;
  min-width: 6rpx;
  opacity: 0.85;
}

.yrowmeta {
  display: block;
  font-size: 19rpx;
  color: #b1b7bd;
  margin-top: 8rpx;
}

.danger {
  text-align: center;
  color: #b1b7bd;
  font-size: 24rpx;
  padding: 32rpx 0;
}
