/* 分类规则管理中心 */
.rules-page {
  --rules-bg: #f4f6f5;
  --rules-card: #ffffff;
  --rules-line: #e6ece8;
  --rules-text: #24352e;
  --rules-muted: #78857e;
  --rules-soft: #f1f5f3;
  --rules-tint: var(--brand-soft, #e7f5ef);
  --rules-accent: var(--brand, #17806b);
  --rules-accent-text: var(--brand-ink, #0f5f50);
  --rules-danger: #c84f43;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom));
  color: var(--rules-text);
  background: var(--rules-bg);
}

.rules-page.dark {
  --rules-bg: #141b18;
  --rules-card: #1e2823;
  --rules-line: #34423a;
  --rules-text: #e2eae5;
  --rules-muted: #a7b5ad;
  --rules-soft: #2a3630;
  --rules-tint: #243f34;
  --rules-accent: #81c7a9;
  --rules-accent-text: #a1dbbe;
  --rules-danger: #ef9b90;
}

.rules-page.dark.theme-ink { --rules-tint: #263949; --rules-accent: #94bddf; --rules-accent-text: #b1d1ec; }
.rules-page.dark.theme-amber { --rules-tint: #443529; --rules-accent: #e0b389; --rules-accent-text: #efc79f; }

.hero {
  margin: 0 -28rpx;
  padding: 44rpx 36rpx 76rpx;
  background: var(--hero-bg, linear-gradient(160deg, #1a8f76 0%, #12695a 100%));
}

.rules-page.dark .hero { background: var(--hero-bg-dark, linear-gradient(160deg, #145247 0%, #0c3730 100%)); }
.hero-title { display: block; color: #ffffff; font-size: 42rpx; font-weight: 600; letter-spacing: 1rpx; }
.hero-subtitle { display: block; margin-top: 14rpx; color: rgba(255, 255, 255, 0.8); font-size: 23rpx; line-height: 1.7; }

.card {
  margin-bottom: 22rpx;
  border: 1rpx solid var(--rules-line);
  border-radius: 24rpx;
  background: var(--rules-card);
}

.summary {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: -48rpx;
  padding: 26rpx 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 45, 40, 0.07);
}

.summary-item { flex: 1; min-width: 0; text-align: center; border-right: 1rpx solid var(--rules-line); }
.summary-item:last-child { border-right: 0; }
.summary-num { display: block; font-size: 40rpx; font-weight: 600; line-height: 1.25; }
.summary-num.accent { color: var(--rules-accent-text); }
.summary-label { display: block; margin-top: 6rpx; color: var(--rules-muted); font-size: 22rpx; }

.loading { display: flex; align-items: center; justify-content: center; padding: 54rpx 24rpx; color: var(--rules-muted); font-size: 25rpx; }
.spinner { width: 30rpx; height: 30rpx; margin-right: 18rpx; border: 4rpx solid var(--rules-line); border-top-color: var(--rules-accent); border-radius: 50%; animation: rules-spin 0.8s linear infinite; }
@keyframes rules-spin { to { transform: rotate(360deg); } }

.error-card { padding: 32rpx; }
.error-title { display: block; font-size: 29rpx; font-weight: 600; }
.error-text { display: block; margin-top: 14rpx; color: var(--rules-danger); font-size: 24rpx; line-height: 1.7; overflow-wrap: break-word; }
.secondary-btn { margin: 24rpx 0 0; padding: 0 30rpx; height: 72rpx; line-height: 72rpx; border: 1rpx solid var(--rules-line); border-radius: 18rpx; background: var(--rules-soft); color: var(--rules-accent-text); font-size: 25rpx; }
.secondary-btn::after { border: 0; }

.search-row { padding: 24rpx; }
.search-box { display: flex; align-items: center; height: 80rpx; padding: 0 22rpx; border-radius: 18rpx; background: var(--rules-soft); }
.search-icon { width: 32rpx; height: 32rpx; margin-right: 16rpx; color: var(--rules-muted); transform: scale(0.82); }
.search-input { flex: 1; min-width: 0; height: 80rpx; color: var(--rules-text); font-size: 27rpx; }
.placeholder { color: var(--rules-muted); }
.search-clear { padding: 6rpx 10rpx; color: var(--rules-muted); font-size: 34rpx; line-height: 1; }
.filters { display: flex; margin-top: 20rpx; }
.filter { flex: 1; padding: 14rpx 8rpx; border-radius: 16rpx; color: var(--rules-muted); text-align: center; font-size: 24rpx; }
.filter + .filter { margin-left: 10rpx; }
.filter.active { background: var(--rules-tint); color: var(--rules-accent-text); font-weight: 600; }

.section-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 6rpx 16rpx; }
.section-title { font-size: 29rpx; font-weight: 600; }
.section-note { color: var(--rules-muted); font-size: 21rpx; }
.text-button { margin: 0; padding: 10rpx 4rpx 10rpx 20rpx; height: auto; line-height: 1.5; border: 0; background: transparent; font-size: 23rpx; font-weight: 400; }
.text-button::after { border: 0; }
.text-button.is-off { background: transparent; opacity: 0.42; }
.danger-text { color: var(--rules-danger); }
.action-error { margin: 0 4rpx 16rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: rgba(200, 79, 67, 0.1); color: var(--rules-danger); font-size: 23rpx; line-height: 1.6; }

.empty { padding: 64rpx 32rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0 auto 22rpx; border-radius: 28rpx; background: var(--rules-soft); color: var(--rules-muted); font-size: 44rpx; }
.empty-title { display: block; font-size: 28rpx; font-weight: 500; }
.empty-desc { display: block; margin-top: 12rpx; color: var(--rules-muted); font-size: 23rpx; line-height: 1.7; }

.rule-list { padding: 0 24rpx; }
.rule-item { padding: 26rpx 0; border-bottom: 1rpx solid var(--rules-line); }
.rule-item:last-child { border-bottom: 0; }
.rule-item.is-disabled .rule-main { opacity: 0.66; }
.rule-main { display: flex; align-items: center; min-width: 0; }
.category-badge { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; margin-right: 20rpx; border-radius: 22rpx; font-size: 30rpx; font-weight: 600; }
.rule-copy { flex: 1; min-width: 0; }
.merchant { display: block; font-size: 29rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.category-line { display: flex; align-items: center; margin-top: 7rpx; }
.category-name { color: var(--rules-muted); font-size: 23rpx; }
.state-tag { margin-left: 12rpx; padding: 3rpx 12rpx; border-radius: 10rpx; font-size: 19rpx; line-height: 1.5; }
.state-tag.enabled { background: var(--rules-tint); color: var(--rules-accent-text); }
.state-tag.disabled { background: var(--rules-soft); color: var(--rules-muted); }
.impact { display: block; margin-top: 7rpx; color: var(--rules-muted); font-size: 21rpx; }
.rule-actions { display: flex; align-items: center; justify-content: flex-end; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx dashed var(--rules-line); }
.rule-switch { margin-right: 24rpx; transform: scale(0.86); transform-origin: right center; }
.delete-button { margin: 0; padding: 10rpx 24rpx; height: auto; line-height: 1.5; border: 1rpx solid var(--rules-line); border-radius: 14rpx; background: transparent; color: var(--rules-danger); font-size: 22rpx; }
.delete-button::after { border: 0; }
.delete-button.is-off { background: transparent; opacity: 0.45; }

.preview-head { margin-top: 14rpx; }
.preview-card { padding: 26rpx; }
.preview-types { display: flex; padding: 5rpx; margin-bottom: 20rpx; border-radius: 17rpx; background: var(--rules-soft); }
.type { flex: 1; padding: 14rpx 8rpx; border-radius: 13rpx; color: var(--rules-muted); text-align: center; font-size: 24rpx; }
.type.active { background: var(--rules-card); color: var(--rules-accent-text); font-weight: 600; box-shadow: 0 3rpx 10rpx rgba(30, 45, 40, 0.06); }
.field { display: flex; align-items: center; min-height: 86rpx; border-bottom: 1rpx solid var(--rules-line); }
.field-label { flex: none; width: 132rpx; color: var(--rules-muted); font-size: 24rpx; }
.field-input { flex: 1; min-width: 0; height: 86rpx; color: var(--rules-text); font-size: 26rpx; text-align: right; }
.preview-result { display: flex; align-items: center; margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; background: var(--rules-soft); }
.result-badge { display: flex; align-items: center; justify-content: center; flex: none; width: 70rpx; height: 70rpx; margin-right: 20rpx; border-radius: 20rpx; font-size: 29rpx; font-weight: 600; }
.result-copy { flex: 1; min-width: 0; }
.result-label { display: block; color: var(--rules-muted); font-size: 20rpx; }
.result-category { display: block; margin-top: 3rpx; color: var(--rules-accent-text); font-size: 31rpx; font-weight: 600; }
.result-source { display: block; margin-top: 5rpx; color: var(--rules-muted); font-size: 21rpx; line-height: 1.5; overflow-wrap: break-word; }
.preview-placeholder { margin-top: 24rpx; padding: 30rpx 20rpx; border: 1rpx dashed var(--rules-line); border-radius: 16rpx; color: var(--rules-muted); text-align: center; font-size: 23rpx; }
.preview-error { margin-top: 20rpx; color: var(--rules-danger); font-size: 23rpx; line-height: 1.6; }
.preview-tip { display: block; margin-top: 18rpx; color: var(--rules-muted); font-size: 20rpx; line-height: 1.7; }
.footer { padding: 20rpx 12rpx 8rpx; color: var(--rules-muted); text-align: center; font-size: 21rpx; line-height: 1.7; }
