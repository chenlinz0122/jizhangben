.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 8rpx 0 40rpx;
  box-sizing: border-box;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #5a6169;
}

.sn {
  width: 104rpx;
  flex: none;
  color: var(--brand, #17806b);
  font-weight: 600;
}

.hint {
  background: #f2f7f5;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  color: #5f7a73;
  line-height: 1.6;
  margin-top: 8rpx;
}

/* 多张图时的处理进度 */
.bar {
  height: 8rpx;
  background: #eceff0;
  border-radius: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.barin {
  height: 100%;
  background: var(--brand, #17806b);
  transition: width 0.2s ease-out;
}

.warn {
  margin-top: 18rpx;
  background: #f7efee;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  color: #d9433f;
  line-height: 1.6;
}

.errbox {
  background: #f7efee;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: #d9433f;
  line-height: 1.6;
}

.stat {
  display: flex;
  gap: 16rpx;
}

.sitem {
  flex: 1;
  background: #f7f8f9;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.sv {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--brand, #17806b);
}

.sl {
  display: block;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.sample {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.ileft {
  flex: 1;
  min-width: 0;
}

.sim {
  display: block;
  font-size: 26rpx;
}

.sisub {
  display: block;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.siamt {
  font-size: 26rpx;
  font-weight: 600;
}

/* 金额颜色：支出红、收入/退款绿、转账灰 */
.siamt.exp { color: #d9433f; }
.siamt.inc { color: #1f7a4d; }
.siamt.mut { color: #6b8f7f; }

.oprow {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.oprow .half {
  flex: 1;
  margin-top: 0;
  padding: 22rpx;
  font-size: 27rpx;
}

.tip {
  display: block;
  margin-top: 18rpx;
  line-height: 1.6;
}

.done {
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  color: #1f7a4d;
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #b1b7bd;
  padding: 20rpx;
}
