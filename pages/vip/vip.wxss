/* 会员页 */

.muted2 {
  font-size: 22rpx;
  color: #a8aeb4;
}

.status {
  padding: 36rpx 32rpx;
}

.status.on {
  background: linear-gradient(135deg, #eaf7f2 0%, #f7fbf9 100%);
  border: 2rpx solid #cfe7df;
}

.st-label {
  font-size: 26rpx;
  color: #6b737a;
}

.st-tag {
  background: #17806b;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
}

.st-main {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #17806b;
}

.st-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.st-days {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #17806b;
}

.code-input {
  height: 96rpx;
  background: #f4f6f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.err {
  display: block;
  color: #d9433f;
  font-size: 24rpx;
  margin: -8rpx 0 20rpx;
}

.hint {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
}

.benefit {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.bf-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #17806b;
  margin: 12rpx 18rpx 0 0;
  flex-shrink: 0;
}

.bf-body {
  flex: 1;
}

.bf-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.bf-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b9198;
  line-height: 1.5;
}

.buy-text {
  display: block;
  font-size: 26rpx;
  color: #4b5257;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ---------- 头图 ---------- */
.hero {
  margin: 0 0 24rpx;
  padding: 40rpx 34rpx 44rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: linear-gradient(160deg, #1a8f76 0%, #12695a 100%);
  color: #fff;
  box-shadow: 0 16rpx 34rpx rgba(18, 105, 90, 0.18);
}

.hero.on {
  background: linear-gradient(160deg, #d9a441 0%, #b3832a 100%);
  box-shadow: 0 16rpx 34rpx rgba(179, 131, 42, 0.2);
}

.hrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hbadge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.hdays {
  font-size: 21rpx;
  opacity: 0.85;
}

.htitle {
  display: block;
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hsub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.82;
}

/* ---------- 档位 ---------- */
.tiers {
  display: flex;
  margin-top: 22rpx;
}

.tier {
  position: relative;
  flex: 1;
  margin: 0 8rpx;
  padding: 26rpx 12rpx 22rpx;
  border-radius: 20rpx;
  background: #f5f7f8;
  border: 2rpx solid #eef1f2;
  text-align: center;
}

.tier.on {
  background: #eaf6f1;
  border-color: #17806b;
  box-shadow: 0 8rpx 20rpx rgba(23, 128, 107, 0.12);
}

.t-name {
  display: block;
  font-size: 24rpx;
  color: #6b737a;
}

.tier.on .t-name {
  color: #17806b;
  font-weight: 600;
}

.t-price {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1f23;
}

.tier.on .t-price {
  color: #0f5f50;
}

.t-days {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa0a6;
}

.t-tag {
  position: absolute;
  top: -14rpx;
  right: -6rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #d9433f;
  color: #fff;
  font-size: 18rpx;
}

.tier-note {
  display: block;
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8b9198;
  text-align: center;
}

/* ---------- 对比表 ---------- */
.cmp-head {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 14rpx 8rpx;
  border-bottom: 2rpx solid #edf0f1;
}

.c-feature {
  flex: 1;
  font-size: 23rpx;
  color: #9aa0a6;
}

.c-vip,
.c-free {
  width: 120rpx;
  text-align: center;
  font-size: 23rpx;
  color: #17806b;
}

.c-free {
  color: #9aa0a6;
}

.cmp-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f4f6f7;
}

.cmp-row.alt {
  background: #fafbfc;
}

.cmp-row .c-feature {
  font-size: 24rpx;
  color: #3c4247;
}

.cmp-row .c-vip,
.cmp-row .c-free {
  font-size: 24rpx;
}

.off {
  color: #c6ccd1 !important;
}

.cmp-foot {
  display: block;
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #b1b7bd;
  line-height: 1.6;
}
